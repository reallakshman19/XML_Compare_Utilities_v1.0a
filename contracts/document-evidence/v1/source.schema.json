{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.xml-compare-utilities.local/document-evidence/v1/source.schema.json",
  "title": "SourceIdentity.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "sourceId", "sha256", "mediaType", "sizeBytes"],
  "properties": {
    "schema": { "const": "SourceIdentity.v1" },
    "sourceId": { "type": "string", "minLength": 1 },
    "sha256": { "$ref": "#/$defs/sha256" },
    "mediaType": { "type": "string", "minLength": 1 },
    "sizeBytes": { "type": "integer", "minimum": 0 },
    "logicalPath": { "type": "string", "minLength": 1 },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "blobSha1"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "blobSha1": { "type": "string", "pattern": "^sha1:[0-9a-f]{40}$" }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
