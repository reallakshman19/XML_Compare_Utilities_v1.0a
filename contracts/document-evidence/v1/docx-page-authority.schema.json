{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.xml-compare-utilities.local/document-evidence/v1/docx-page-authority.schema.json",
  "title": "DocxPageAuthority.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "sourceHash", "semanticContentHash", "renderProfileHash", "pageNumber", "surfaceId", "surfaceHash", "semanticAuthority", "visualAuthority"],
  "properties": {
    "schema": {"const": "DocxPageAuthority.v1"},
    "sourceHash": {"$ref": "#/$defs/sha256"},
    "semanticContentHash": {"$ref": "#/$defs/sha256"},
    "renderProfileHash": {"$ref": "#/$defs/sha256"},
    "pageNumber": {"type": "integer", "minimum": 1},
    "surfaceId": {"type": "string", "minLength": 1},
    "surfaceHash": {"$ref": "#/$defs/sha256"},
    "semanticAuthority": {"const": "ooxml"},
    "visualAuthority": {"const": "render-profile-bound"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
