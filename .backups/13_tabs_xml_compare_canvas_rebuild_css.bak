.xml-compare-workspace-shell.is-rebuilt {
  padding: 12px;
  border-bottom: 1px solid rgba(148, 163, 184, 0.18);
  background: radial-gradient(circle at top, rgba(37, 99, 235, 0.11), rgba(2, 6, 23, 0.22));
}

.xml-compare-workspace-grid.is-two-canvas {
  display: grid;
  grid-template-columns: minmax(280px, 1fr) minmax(300px, 400px) minmax(280px, 1fr);
  gap: 12px;
  align-items: stretch;
}

.xml-compare-workspace-side,
.xml-compare-connector-lane {
  min-width: 0;
  border: 1px solid rgba(96, 165, 250, 0.22);
  border-radius: 14px;
  background: rgba(15, 23, 42, 0.78);
  overflow: hidden;
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.03);
}

.xml-compare-side-title,
.xml-compare-connector-lane header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  padding: 9px 11px;
  border-bottom: 1px solid rgba(148, 163, 184, 0.14);
  color: #bfdbfe;
  font-size: 12px;
}

.xml-compare-side-title span,
.xml-compare-connector-lane header span,
.xml-compare-connector-lane small {
  color: #94a3b8;
  font-size: 11px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.xml-compare-canvas-host.is-graphical {
  border: 0;
  border-radius: 0;
  background: transparent;
}

.xml-compare-canvas-host.is-graphical > header {
  display: none;
}

.xml-compare-canvas-host.is-graphical .xml-compare-canvas-toolbar {
  padding: 8px 10px;
  background: rgba(2, 6, 23, 0.28);
}

.xml-compare-graph-canvas {
  position: relative;
  height: clamp(260px, 38vh, 420px);
  min-height: 260px;
  overflow: hidden;
  border-top: 1px solid rgba(148, 163, 184, 0.12);
  border-bottom: 1px solid rgba(148, 163, 184, 0.12);
  background:
    linear-gradient(rgba(96, 165, 250, 0.06) 1px, transparent 1px),
    linear-gradient(90deg, rgba(96, 165, 250, 0.06) 1px, transparent 1px),
    radial-gradient(circle at center, rgba(59, 130, 246, 0.14), rgba(2, 6, 23, 0.50));
  background-size: 24px 24px, 24px 24px, auto;
}

.xml-compare-graph-canvas .xml-compare-canvas-reticle {
  position: absolute;
  inset: 50% auto auto 50%;
  transform: translate(-50%, -50%);
  opacity: 0.20;
  pointer-events: none;
}

.xml-compare-graph-node {
  position: absolute;
  transform: translate(-50%, -50%);
  width: 86px;
  min-height: 48px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2px;
  border: 1px solid rgba(147, 197, 253, 0.36);
  border-radius: 999px;
  background: rgba(15, 23, 42, 0.88);
  color: #dbeafe;
  cursor: pointer;
  box-shadow: 0 8px 24px rgba(2, 6, 23, 0.28);
  transition: transform 0.12s ease, border-color 0.12s ease, background 0.12s ease;
}

.xml-compare-graph-node:hover,
.xml-compare-graph-node.is-hovered {
  transform: translate(-50%, -50%) scale(1.05);
  border-color: rgba(125, 211, 252, 0.92);
  background: rgba(30, 41, 59, 0.96);
}

.xml-compare-graph-node.is-selected {
  border-color: rgba(34, 197, 94, 0.95);
  background: rgba(20, 83, 45, 0.92);
  box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.18), 0 12px 28px rgba(2, 6, 23, 0.35);
}

.xml-compare-graph-node b {
  max-width: 70px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 11px;
}

.xml-compare-graph-node span {
  max-width: 72px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #bfdbfe;
  font-size: 9px;
}

.xml-compare-graph-empty {
  position: absolute;
  inset: 0;
  display: grid;
  place-items: center;
  color: #94a3b8;
  font-size: 12px;
}

.xml-compare-connector-lane {
  display: flex;
  flex-direction: column;
}

.xml-compare-connector-lane small {
  display: block;
  padding: 8px 10px;
  border-top: 1px solid rgba(148, 163, 184, 0.12);
  white-space: normal;
  line-height: 1.35;
}

.xml-compare-connector-overlay-panel {
  flex: 1;
  min-height: 260px;
  display: flex;
  flex-direction: column;
  background: rgba(2, 6, 23, 0.30);
}

.xml-compare-connector-summary {
  display: grid;
  grid-template-columns: auto 1fr auto 1fr auto 1fr;
  gap: 5px 6px;
  padding: 8px 10px;
  color: #cbd5e1;
  font-size: 10px;
  border-bottom: 1px solid rgba(148, 163, 184, 0.12);
}

.xml-compare-connector-summary b {
  color: #93c5fd;
}

.xml-compare-connector-overlay-svg {
  flex: 1;
  width: 100%;
  min-height: 230px;
}

.xml-compare-connector-overlay-svg path {
  fill: none;
  stroke: #38bdf8;
  stroke-width: 1.8;
  vector-effect: non-scaling-stroke;
}

.xml-compare-connector-overlay-svg circle {
  fill: #bfdbfe;
}

.xml-compare-connector-overlay-svg text {
  fill: #dbeafe;
  font-size: 4px;
  text-anchor: middle;
  dominant-baseline: central;
}

.xml-compare-connector-overlay-svg .connector-manual-locked path {
  stroke: #22c55e;
  stroke-width: 2.4;
}

.xml-compare-connector-overlay-svg .connector-pending-source path,
.xml-compare-connector-overlay-svg .connector-preview path {
  stroke: #f59e0b;
  stroke-dasharray: 4 3;
}

.xml-compare-compare-field-controls {
  width: 100%;
  display: grid;
  gap: 7px;
  margin-top: 8px;
  padding-top: 8px;
  border-top: 1px solid rgba(148, 163, 184, 0.14);
}

.xml-compare-compare-field-controls label {
  display: grid;
  gap: 4px;
  color: #bfdbfe;
  font-size: 11px;
}

.xml-compare-compare-field-controls select {
  width: 100%;
  border: 1px solid rgba(96, 165, 250, 0.28);
  border-radius: 8px;
  background: #020617;
  color: #dbeafe;
  padding: 6px;
}

.xml-compare-compare-field-list {
  display: flex;
  flex-wrap: wrap;
  gap: 5px;
}

.xml-compare-compare-field-pill {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  border: 1px solid rgba(125, 211, 252, 0.28);
  border-radius: 999px;
  padding: 4px 6px;
  color: #e0f2fe;
  background: rgba(15, 23, 42, 0.72);
  font-size: 10px;
}

.xml-compare-compare-field-pill button {
  border: 0;
  background: transparent;
  color: #fca5a5;
  padding: 0 2px;
}

.xml-compare-graph-canvas.is-tiles,
.xml-compare-graph-canvas.is-compact-list,
.xml-compare-graph-canvas.is-grouped-tree,
.xml-compare-graph-canvas.is-grouped-compact-tree {
  height: clamp(360px, 58vh, 680px);
  min-height: 360px;
  overflow: auto;
  padding: 12px;
}

.xml-compare-graph-canvas.is-tiles .xml-compare-graph-watermark,
.xml-compare-graph-canvas.is-compact-list .xml-compare-graph-watermark,
.xml-compare-graph-canvas.is-grouped-tree .xml-compare-graph-watermark,
.xml-compare-graph-canvas.is-grouped-compact-tree .xml-compare-graph-watermark {
  position: sticky;
  top: 0;
  z-index: 0;
  opacity: 0.08;
}

.xml-compare-dynamic-tile-board,
.xml-compare-dynamic-list {
  position: relative;
  z-index: 1;
}

.xml-compare-dynamic-tile-board {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
  gap: 8px;
  align-items: stretch;
}

.xml-compare-dynamic-list {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(118px, 1fr));
  gap: 7px;
  align-items: stretch;
}

.xml-compare-dynamic-tree {
  position: relative;
  z-index: 1;
  display: grid;
  gap: 12px;
}

.xml-compare-dynamic-line-group,
.xml-compare-dynamic-element-group,
.xml-compare-dynamic-node-group {
  border: 1px solid rgba(147, 197, 253, 0.18);
  border-radius: 12px;
  background: rgba(15, 23, 42, 0.62);
  padding: 8px;
}

.xml-compare-dynamic-element-group,
.xml-compare-dynamic-node-group {
  margin-top: 8px;
  background: rgba(2, 6, 23, 0.32);
}

.xml-compare-dynamic-line-group > header,
.xml-compare-dynamic-element-group > header,
.xml-compare-dynamic-node-group > header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 8px;
  padding: 0 2px 8px;
  color: #bfdbfe;
  font-size: 11px;
}

.xml-compare-dynamic-line-group > header span,
.xml-compare-dynamic-element-group > header span,
.xml-compare-dynamic-node-group > header span {
  color: #94a3b8;
  font-size: 10px;
}

.xml-compare-graph-canvas .xml-compare-dynamic-tile.xml-compare-graph-node {
  position: static;
  transform: none;
  width: auto;
  min-height: 38px;
  align-items: flex-start;
  justify-content: center;
  gap: 2px;
  border-radius: 10px;
  padding: 7px 8px;
  text-align: left;
}

.xml-compare-graph-canvas .xml-compare-dynamic-tile.xml-compare-graph-node:hover,
.xml-compare-graph-canvas .xml-compare-dynamic-tile.xml-compare-graph-node.is-hovered {
  transform: translateY(-1px);
}

.xml-compare-graph-canvas .xml-compare-dynamic-tile.xml-compare-graph-node b,
.xml-compare-graph-canvas .xml-compare-dynamic-tile.xml-compare-graph-node span {
  max-width: 100%;
}

.xml-compare-graph-canvas .xml-compare-dynamic-tile.xml-compare-graph-node b {
  font-size: 11px;
  line-height: 1.15;
}

.xml-compare-graph-canvas .xml-compare-dynamic-tile.xml-compare-graph-node span {
  font-size: 9px;
  opacity: 0.78;
}

.xml-compare-graph-canvas .xml-compare-dynamic-tile.xml-compare-graph-node small {
  display: none;
}

.xml-compare-graph-canvas .xml-compare-dynamic-tile.xml-compare-graph-node.is-compact {
  min-height: 34px;
  padding: 6px 7px;
}

.xml-compare-dynamic-evidence-row {
  min-width: 0;
}

@media (max-width: 980px) {
  .xml-compare-workspace-grid.is-two-canvas {
    grid-template-columns: 1fr;
  }
  .xml-compare-connector-overlay-panel {
    min-height: 130px;
  }
  .xml-compare-dynamic-tile-board,
  .xml-compare-dynamic-list {
    grid-template-columns: repeat(auto-fill, minmax(112px, 1fr));
  }
}

/* --- Modal Popup Styles --- */
body:has(dialog[open]) {
  overflow: hidden;
}

.xml-compare-transfer-modal {
  position: fixed;
  inset: 5vh 5vw;
  width: 90vw;
  height: 90vh;
  margin: 0 !important;
  box-sizing: border-box !important;
  padding: 0;
  border: 1px solid rgba(147, 197, 253, 0.4);
  border-radius: 12px;
  background: #0f172a;
  color: #e2e8f0;
  box-shadow: 0 20px 40px rgba(0,0,0,0.8);
  z-index: 1000;
  overflow: hidden;
}

.xml-compare-transfer-modal * {
  box-sizing: border-box !important;
}

.xml-compare-transfer-modal[open] {
  display: flex;
  flex-direction: column;
}

.xml-compare-transfer-modal::backdrop {
  background: rgba(2, 6, 23, 0.85);
  backdrop-filter: blur(4px);
}

.xml-compare-modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16px 20px;
  border-bottom: 1px solid rgba(148, 163, 184, 0.2);
  background: rgba(30, 41, 59, 0.5);
}

.xml-compare-modal-header h2 {
  margin: 0;
  font-size: 16px;
  color: #bae6fd;
}

.xml-compare-modal-close {
  background: none;
  border: none;
  color: #94a3b8;
  font-size: 24px;
  cursor: pointer;
  line-height: 1;
}

.xml-compare-modal-close:hover {
  color: #ef4444;
}

.xml-compare-modal-tabs {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 8px;
  padding: 12px 20px;
  background: rgba(15, 23, 42, 0.4);
  border-bottom: 1px solid rgba(148, 163, 184, 0.12);
}

.xml-compare-modal-tab-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 10px 24px;
  background: rgba(30, 41, 59, 0.3);
  border: 1px solid rgba(148, 163, 184, 0.15);
  border-radius: 30px;
  color: #94a3b8;
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  letter-spacing: 0.02em;
}

.xml-compare-modal-tab-btn:hover {
  color: #f1f5f9;
  background: rgba(255, 255, 255, 0.05);
  border-color: rgba(148, 163, 184, 0.3);
  transform: translateY(-1px);
}

.xml-compare-modal-tab-btn.is-active {
  color: #ffffff;
  background: linear-gradient(135deg, #0284c7, #0369a1);
  border-color: #38bdf8;
  box-shadow: 0 4px 14px rgba(3, 105, 161, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.2);
  text-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
}

.xmlc-tab-icon {
  font-size: 14px;
  line-height: 1;
}

.xmlc-tab-text {
  line-height: 1;
}

.xml-compare-modal-body {
  flex: 1;
  /* CRITICAL: min-height:0 allows the flex child to be bounded by the
     parent dialog's finite height (90vh). Without this, the child grows
     to its content size and overflow-y:auto never fires a scrollbar. */
  min-height: 0;
  overflow-y: auto;
  padding: 20px;
  /* Block display so children render at their true intrinsic height */
  display: block;
  scrollbar-width: thin;
  scrollbar-color: rgba(148, 163, 184, 0.4) transparent;
}

.xml-compare-modal-body::-webkit-scrollbar {
  width: 6px;
}

.xml-compare-modal-body::-webkit-scrollbar-track {
  background: transparent;
}

.xml-compare-modal-body::-webkit-scrollbar-thumb {
  background: rgba(148, 163, 184, 0.4);
  border-radius: 999px;
}

.xml-compare-modal-body::-webkit-scrollbar-thumb:hover {
  background: rgba(148, 163, 184, 0.65);
}

/* Tab-pane hide guard: beats any !important display rules on inner classes
   (e.g. display:flex !important on .xmlc-transfer-review).
   Specificity 0,2,0 (class + :not pseudo-class) > 0,1,0 (single class).
   Inactive panes MUST stay hidden regardless of inner class declarations. */
.xml-compare-modal-tab-content:not(.is-active) {
  display: none !important;
}

.xml-compare-modal-tab-content {

  /* Block display: children render at their natural height so the parent
     scroll container can measure them correctly. Do NOT use flex/grid here
     or children with overflow-y:visible collapse to zero height. */
  display: block;
  padding-bottom: 8px;
}

/* Spacing between block-level sections within each tab pane */
.xml-compare-modal-tab-content > * + * {
  margin-top: 16px;
}

.xmlc-candidate-review-stack > * + * {
  margin-top: 12px;
}


.xml-compare-connector-lane-container {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.xml-compare-review-btn {
  margin-top: 8px;
  padding: 12px;
  background: #2563eb;
  color: #fff;
  border: none;
  border-radius: 8px;
  font-weight: 600;
  cursor: pointer;
  box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);
  transition: background 0.2s;
}

.xml-compare-review-btn:hover {
  background: #1d4ed8;
}
