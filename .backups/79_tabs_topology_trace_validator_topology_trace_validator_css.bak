/*
 * Functionality: static, read-only four-zone layout and SVG evidence styling.
 * Inputs are topology validator semantic classes/data attributes. Output is a
 * responsive GitHub Pages-compatible workspace. Fallback: narrow screens keep
 * panels scrollable; no editing affordances are introduced.
 */

.ttv-svg-content text{font-family:ui-monospace,SFMono-Regular,Consolas,monospace;font-size:11px;fill:#cbd5e1}.ttv-source-route path{fill:none;stroke:#94a3b8;stroke-width:1.5;stroke-dasharray:8 5;vector-effect:non-scaling-stroke}.ttv-source-route.is-ambiguous path,.ttv-trace-link.ttv-disposition-block_ambiguous{stroke:#a855f7}.ttv-source-port{fill:#94a3b8}.ttv-canonical-edge path{fill:none;stroke:#22d3ee;stroke-width:2;vector-effect:non-scaling-stroke}.ttv-canonical-node circle{fill:#22d3ee;stroke:#083344;stroke-width:2}.ttv-junction rect{fill:#facc15;stroke:#713f12}.ttv-point-feature path{fill:#f472b6;stroke:#831843}.ttv-boundary circle{fill:none;stroke:#ef4444;stroke-width:3}.is-invalid path,.is-invalid circle,.is-invalid rect{stroke:#ef4444!important;fill:#7f1d1d!important}.ttv-symbol-label{fill:#e2e8f0!important}.ttv-lane-title{fill:#67e8f9!important;font-size:15px!important;font-weight:700}.ttv-lane-rule{stroke:#334155}.ttv-trace-link{fill:none;stroke:#22d3ee;stroke-width:2}.ttv-disposition-split_to_multiple_edges{stroke-dasharray:7 3}.ttv-disposition-merge_in_cii_projection{stroke:#f59e0b}.ttv-disposition-emit_point_feature{stroke:#f472b6}.ttv-disposition-defer_support{stroke:#94a3b8;stroke-dasharray:3 5}.ttv-lane-object rect{fill:#0f172a;stroke:#334155;stroke-width:2}.ttv-source-object rect{stroke:#94a3b8}.ttv-target-point rect{stroke:#f472b6}.ttv-target-junction rect{stroke:#facc15}.ttv-target-boundary rect{stroke:#ef4444}.ttv-lane-object text{text-anchor:middle}.ttv-branch-box rect{fill:#0f172a;stroke:#22d3ee}.ttv-reference-row.is-resolved text{fill:#86efac}.ttv-reference-row.is-unresolved text{fill:#f87171}.ttv-map-note{fill:#94a3b8!important}.ttv-no-issues{text-anchor:middle;fill:#86efac!important;font-size:22px!important}.ttv-issues-heading{fill:#f87171!important;font-size:18px!important}.ttv-issue-object rect{fill:#2a1015;stroke:#ef4444}.ttv-issue-object.is-ambiguous rect{fill:#2e1065;stroke:#a855f7}.ttv-issue-object text:first-of-type{fill:#fecaca;font-weight:700}.is-selected{filter:drop-shadow(0 0 7px #fff)}.is-related{filter:drop-shadow(0 0 5px #facc15)}tr.is-selected,tr.is-related{background:#164e63}.ttv-inspector-section{border-bottom:1px solid #26354a;padding-bottom:9px}.ttv-inspector-section h3{color:#67e8f9;font-size:11px;letter-spacing:.08em}.ttv-inspector-section div{display:grid;grid-template-columns:115px 1fr;gap:7px;margin:4px 0}.ttv-inspector-section dt{color:#94a3b8}.ttv-inspector-section dd{margin:0;overflow-wrap:anywhere}.ttv-inspector-empty{color:#64748b}.ttv-bottom{min-height:0;background:#07101f;border-top:1px solid #26354a;overflow:hidden}.ttv-bottom-tabbar{display:flex;gap:2px;padding:5px 8px;border-bottom:1px solid #26354a}.ttv-bottom-tabbar button{background:transparent;color:#94a3b8;border:0;border-bottom:2px solid transparent;padding:5px 8px;cursor:pointer}.ttv-bottom-tabbar button.is-active{color:#67e8f9;border-color:#22d3ee}.ttv-bottom-content{height:205px;overflow:auto;padding:8px}.ttv-table-scroll{overflow:auto;max-height:190px}.ttv-bottom table{width:100%;border-collapse:collapse}.ttv-bottom th,.ttv-bottom td{border:1px solid #26354a;padding:4px 6px;text-align:left;vertical-align:top}.ttv-bottom th{position:sticky;top:0;background:#0f172a;color:#67e8f9;resize:horizontal;overflow:hidden}.ttv-summary-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}.ttv-summary-grid h3{margin:0 0 5px;color:#67e8f9}.ttv-summary-grid dl{display:grid;grid-template-columns:repeat(2,1fr);gap:4px;margin:0}.ttv-summary-grid dl div{display:flex;justify-content:space-between;gap:8px;border-bottom:1px solid #1e293b}.ttv-summary-grid dt{color:#94a3b8}.ttv-summary-grid dd{margin:0}.ttv-summary-grid .is-pass dd{color:#86efac}.ttv-summary-grid .is-fail dd,.ttv-not-evaluated{color:#fbbf24}.ttv-status{padding:5px 10px;background:#0f172a;border-top:1px solid #26354a}.ttv-status[data-status=error]{color:#fca5a5}.ttv-status[data-status=pass]{color:#86efac}.ttv-status[data-status=ready]{color:#67e8f9}@media(max-width:1050px){.ttv-main{grid-template-columns:200px minmax(360px,1fr)}.ttv-inspector{position:absolute;right:0;top:118px;bottom:275px;width:280px;background:rgba(11,19,36,.96)}.ttv-toolbar{max-height:110px;overflow:auto}}

.ttv-map-junction rect{fill:#29220a;stroke:#facc15}.ttv-map-boundary circle{fill:none;stroke:#ef4444;stroke-width:3}
.ttv-component-symbol{fill:#081525;stroke:#e2e8f0;stroke-width:2;vector-effect:non-scaling-stroke}.ttv-component-symbol path,.ttv-component-symbol circle,.ttv-component-symbol rect{vector-effect:non-scaling-stroke}.ttv-component-pipe{fill:none;stroke:#94a3b8}.ttv-component-valve{fill:#0f172a;stroke:#38bdf8}.ttv-component-flange,.ttv-component-gask{fill:none;stroke:#f8fafc}.ttv-component-inst circle{fill:#0f172a;stroke:#c084fc}.ttv-component-reducer{fill:#164e63;stroke:#67e8f9}.ttv-component-elbo-bend{fill:none;stroke:#22d3ee;stroke-width:3}.ttv-component-tee{fill:#facc15;stroke:#713f12}.ttv-component-olet{fill:#f472b6;stroke:#831843}.ttv-component-support{fill:none;stroke:#94a3b8;stroke-dasharray:3 2}
.ttv-disposition-emit_route_edge{stroke:#22d3ee}.ttv-disposition-emit_inline_component_edge{stroke:#38bdf8}.ttv-disposition-emit_bend_edge_set,.ttv-disposition-split_header_at_junction{stroke:#22d3ee;stroke-dasharray:7 3}.ttv-disposition-emit_tee_junction{stroke:#facc15}.ttv-disposition-emit_olet_junction{stroke:#f472b6}
.ttv-target-projection rect{stroke:#f59e0b}
.ttv-component-cards{display:grid;grid-template-columns:repeat(5,minmax(150px,1fr));gap:7px;margin-bottom:10px}.ttv-component-card{border:1px solid #334155;border-radius:7px;background:#0f172a;padding:8px}.ttv-component-card h4{margin:0 0 4px;color:#67e8f9}.ttv-component-card strong,.ttv-component-card span{display:block}.ttv-component-card[data-result=PASS] strong{color:#86efac}.ttv-component-card[data-result=WARNING] strong{color:#fbbf24}.ttv-component-card[data-result=FAIL] strong{color:#fca5a5}.ttv-focus-button{background:#164e63;color:#cffafe;border:1px solid #22d3ee;border-radius:4px;cursor:pointer}
@media(max-width:1200px){.ttv-component-cards{grid-template-columns:repeat(2,minmax(150px,1fr))}}

.ttv-center{position:relative}.ttv-svg{cursor:grab;touch-action:none;user-select:none;outline:none}.ttv-svg:focus{box-shadow:inset 0 0 0 2px #22d3ee}.ttv-svg.is-panning{cursor:grabbing}.ttv-navigation-hint{position:absolute;right:10px;bottom:8px;padding:4px 8px;border:1px solid #334155;border-radius:5px;background:rgba(2,6,23,.86);color:#94a3b8;pointer-events:none}.ttv-source-route .ttv-hit-path,.ttv-canonical-edge .ttv-hit-path{fill:none!important;stroke:transparent!important;stroke-width:18!important;stroke-dasharray:none!important;pointer-events:stroke}.ttv-filter-message rect{fill:rgba(15,23,42,.94);stroke:#22d3ee}.ttv-filter-message text{fill:#cffafe!important;font-size:13px!important}
.ttv-search-results:empty{display:none}.ttv-search-results{margin:8px 0;border:1px solid #334155;border-radius:6px;padding:6px;background:#07101f}.ttv-search-results h2{display:flex;justify-content:space-between;margin:0 0 5px}.ttv-search-result-list{max-height:190px;overflow:auto}.ttv-search-result-list button{display:grid;grid-template-columns:64px minmax(0,1fr);gap:2px 5px;width:100%;padding:5px;border:0;border-bottom:1px solid #1e293b;background:transparent;color:#e2e8f0;text-align:left;cursor:pointer}.ttv-search-result-list button:hover,.ttv-search-result-list button.is-selected{background:#164e63}.ttv-search-result-list b{color:#67e8f9}.ttv-search-result-list span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.ttv-search-result-list small{grid-column:1/-1;color:#94a3b8;overflow-wrap:anywhere}.ttv-search-empty,.ttv-search-overflow{margin:4px;color:#94a3b8}

.ttv-3d-container{width:100%;height:100%;position:relative}.ttv-3d-canvas-host{width:100%;height:100%}.ttv-3d-overlay{position:absolute;top:12px;left:12px;display:flex;flex-direction:column;gap:6px;z-index:10}.ttv-3d-btn{width:36px;height:36px;display:flex;align-items:center;justify-content:center;border:1px solid #334155;border-radius:6px;background:#172033;color:#dbeafe;cursor:pointer;font-size:14px;box-shadow:0 4px 10px rgba(0,0,0,.4);transition:all .2s;padding:0}.ttv-3d-btn:hover{border-color:#22d3ee;background:#164e63;transform:translateY(-1px)}
