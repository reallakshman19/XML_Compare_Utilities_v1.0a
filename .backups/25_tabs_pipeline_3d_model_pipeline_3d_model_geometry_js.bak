// Pure JS geometry helpers for the "Pipeline 3D Model" utility.
// No DOM dependency — parses the 3 pasted tables and produces a combined
// Coordinate-tab-shaped point list (horizontal chainage + X/Y/Z + node name).

const NUMBER_RE = /-?\d+(?:\.\d+)?/g;

function splitLines(text) {
  return String(text || '').split(/\r?\n/).map((line) => line.trim()).filter(Boolean);
}

function extractNumbers(line) {
  const matches = String(line || '').match(NUMBER_RE);
  return matches ? matches.map(Number) : [];
}

function round(value, places = 3) {
  const factor = 10 ** places;
  return Math.round((Number(value) || 0) * factor) / factor;
}

function isSeparatorLine(line) {
  return /^[-|:\s]+$/.test(line);
}

// Splits a row into cells (tab > pipe > comma/whitespace, whichever the line
// actually uses), so a label like "IP3-IP Start" is classified as ONE
// non-numeric token instead of having its embedded digit ("3") matched by a
// bare numeric regex scan across the whole line.
function tokenizeRow(line) {
  let parts;
  if (line.includes('\t')) parts = line.split('\t');
  else if (line.includes('|')) parts = line.split('|');
  else parts = line.split(/,|\s+/);
  return parts.map((part) => part.trim()).filter((part) => part.length);
}

function isNumericToken(token) {
  return /^-?\d+(?:\.\d+)?$/.test(token);
}

// Rotates (x, y) by angleDeg (in the XY plane) then translates by the anchor.
// Z is not rotated — only translated by anchorZ.
function rotateAndTranslate(x, y, z, anchorX, anchorY, anchorZ, angleDeg) {
  const rad = ((Number(angleDeg) || 0) * Math.PI) / 180;
  const cos = Math.cos(rad);
  const sin = Math.sin(rad);
  return {
    globalX: anchorX + (x * cos - y * sin),
    globalY: anchorY + (x * sin + y * cos),
    globalZ: anchorZ + z,
  };
}

// The Origin Global Coordinate is ONE anchor for the whole geometry (the
// real-world position of the very first point's local (0,0,0)) — not a
// separate value per sheet. When the route crosses into a re-oriented sheet
// (its Angle differs from the row before), that sheet's local frame is
// anchored not at a fresh user-supplied origin but at wherever the PREVIOUS
// row's chain physically landed — that's what "continuity at the match
// line" means. So we walk the rows in order, carrying a running anchor
// forward, and only re-anchor (to the previous row's computed Global
// position) when Angle changes.
function chainGlobalPositions(points) {
  if (!points.length) return points;
  let anchorX = points[0].originX;
  let anchorY = points[0].originY;
  let anchorZ = points[0].originZ;
  let angle = points[0].angleDeg;
  for (let i = 0; i < points.length; i++) {
    const p = points[i];
    if (i > 0 && p.originalAngleDeg !== points[i - 1].originalAngleDeg) {
      const prev = points[i - 1];
      const oldAngle = p.originalAngleDeg;
      let newAngle = p.angleDeg;
      
      // Force collinearity across sheets: compute the required global angle for the new sheet
      // so that its first segment aligns with the previous sheet's last segment.
      if (i >= 2 && i < points.length - 1) {
        const prevA = points[i - 2];
        const prevB = points[i - 1];
        const prevBearing = bearingDeg({ x: prevA.globalX, y: prevA.globalY }, { x: prevB.globalX, y: prevB.globalY });
        
        const nextA = p;
        const nextB = points[i + 1];
        const nextBearingLocal = bearingDeg(nextA, nextB);
        
        newAngle = normalizeAngleDeg(prevBearing - nextBearingLocal);
      }
      
      angle = newAngle;
      const rad = (angle * Math.PI) / 180;
      const cos = Math.cos(rad);
      const sin = Math.sin(rad);
      
      // Match point anchoring: The local point (p.x, p.y) must land exactly on prev.global.
      anchorX = prev.globalX - (p.x * cos - p.y * sin);
      anchorY = prev.globalY - (p.x * sin + p.y * cos);
      anchorZ = prev.globalZ - p.z;
      
      // Apply the corrected angle to all remaining points in this sheet 
      // to avoid triggering this boundary block again.
      for (let k = i; k < points.length; k++) {
        if (points[k].angleDeg === oldAngle) {
          points[k].angleDeg = newAngle;
        } else {
          break;
        }
      }
    }
    const { globalX, globalY, globalZ } = rotateAndTranslate(p.x, p.y, p.z, anchorX, anchorY, anchorZ, angle);
    p.globalX = globalX;
    p.globalY = globalY;
    p.globalZ = globalZ;
  }
  return points;
}

const AT_POINT_RE = /at\s*point\s*X\s*=\s*(-?[\d.]+)\s*Y\s*=\s*(-?[\d.]+)\s*Z\s*=\s*(-?[\d.]+)/i;
const CONSTANT_WIDTH_RE = /constant\s*width\s+(-?[\d.]+)/i;
const AREA_RE = /^\s*area\s+(-?[\d.]+)/i;
const LENGTH_RE = /^\s*length\s+(-?[\d.]+)/i;

// Alternative Table 1 input: CAD/GIS-style dump with metadata lines
// ("Constant width", "area", "length") followed by "at point X= Y= Z=" rows,
// e.g.:
//   Constant width     0.300
//             length   511.100
//           at point  X=  661.549  Y= -160.249  Z=    0.000
// No label, Origin, or Angle columns are available in this format, so points
// get auto-generated labels and default to Origin (0,0,0) / Angle 0 — same
// as a legacy 3-number frozen-format row.
function isAltPointFormatText(text) {
  return AT_POINT_RE.test(text);
}

// Multiple blank-line-separated blocks in the alt-format input mean the
// route was exported from more than one sheet — one block per sheet.
function splitIntoBlocks(text) {
  return String(text || '')
    .split(/\n\s*\n/)
    .map((block) => block.trim())
    .filter(Boolean);
}

function parseAltFormatBlock(blockText) {
  const rawPoints = [];
  let constantWidth = null;
  let area = null;
  let length = null;
  for (const rawLine of splitLines(blockText)) {
    const pointMatch = rawLine.match(AT_POINT_RE);
    if (pointMatch) {
      const [, x, y, z] = pointMatch;
      rawPoints.push({ x: Number(x), y: Number(y), z: Number(z) });
      continue;
    }
    const widthMatch = rawLine.match(CONSTANT_WIDTH_RE);
    if (widthMatch) constantWidth = Number(widthMatch[1]);
    const areaMatch = rawLine.match(AREA_RE);
    if (areaMatch) area = Number(areaMatch[1]);
    const lengthMatch = rawLine.match(LENGTH_RE);
    if (lengthMatch) length = Number(lengthMatch[1]);
  }
  return { rawPoints, meta: { constantWidth, area, length } };
}

function parseAltPointFormat(text) {
  return parseAltFormatBlock(text).rawPoints.map((p, i) => ({
    label: `Point ${i + 1}`,
    x: p.x,
    y: p.y,
    z: p.z,
    originX: 0,
    originY: 0,
    originZ: 0,
    angleDeg: 0,
    originalAngleDeg: 0,
  }));
}

function bearingDeg(a, b) {
  return (Math.atan2(b.y - a.y, b.x - a.x) * 180) / Math.PI;
}

function normalizeAngleDeg(angle) {
  return ((angle % 360) + 360) % 360;
}

// Picks the reference segment for bearing-matching across a sheet boundary.
// Removes the previous assumption of skipping the first segment.
// The user explicitly verified that the element crossing the match line 
// should be colinear with the next element, so we use the boundary segment itself.
function pickReferenceSegment(pts, fromStart) {
  const segments = [];
  const count = Math.min(3, pts.length - 1);
  for (let i = 0; i < count; i += 1) {
    const [a, b] = fromStart ? [pts[i], pts[i + 1]] : [pts[pts.length - 2 - i], pts[pts.length - 1 - i]];
    segments.push({ length: Math.hypot(b.x - a.x, b.y - a.y), bearing: bearingDeg(a, b) });
  }
  return segments[0] || { length: 0, bearing: 0 };
}

// Chains multiple alt-format blocks (sheets) together: sheet 1 is placed as-is
// (Origin (0,0,0), Angle 0). Every later sheet's Angle is derived — not
// user-supplied — by matching the bearing of its first real segment (in its
// own local frame) against the bearing of the previous sheet's last real
// segment (already in the compounded global frame, so this naturally
// compounds across any number of sheets without extra bookkeeping). The
// sheet's anchor (translation) is then solved so its own first point lands
// exactly on the previous sheet's last computed Global point — the
// continuity-at-the-match-line assumption.
function buildMultiSheetTable1(blocks) {
  const points = [];
  blocks.forEach((block, sheetIndex) => {
    const raw = block.rawPoints;
    let angle = 0;
    let anchorX = 0;
    let anchorY = 0;
    let anchorZ = 0;
    if (sheetIndex > 0 && raw.length) {
      const prevSheetPoints = points.filter((p) => p.sheetIndex === sheetIndex - 1);
      const prevLast = prevSheetPoints[prevSheetPoints.length - 1];
      if (prevSheetPoints.length >= 2 && raw.length >= 2) {
        const rawAngle = 0;
        angle = 0;
      }
      if (prevLast) {
        const firstLocal = raw[0] || { x: 0, y: 0, z: 0 };
        const rotatedFirst = rotateAndTranslate(firstLocal.x, firstLocal.y, firstLocal.z, 0, 0, 0, angle);
        anchorX = prevLast.globalX - rotatedFirst.globalX;
        anchorY = prevLast.globalY - rotatedFirst.globalY;
        anchorZ = prevLast.globalZ - rotatedFirst.globalZ;
      }
    }
    raw.forEach((p, j) => {
      const { globalX, globalY, globalZ } = rotateAndTranslate(p.x, p.y, p.z, anchorX, anchorY, anchorZ, angle);
      points.push({
        label: `Sheet ${sheetIndex + 1} Pt ${j + 1}`,
        x: p.x,
        y: p.y,
        z: p.z,
        originX: round(anchorX),
        originY: round(anchorY),
        originZ: round(anchorZ),
        angleDeg: round(angle, 4), originalAngleDeg: round(angle, 4),
        globalX,
        globalY,
        globalZ,
        sheetIndex,
        sheetMeta: block.meta,
      });
    });
  });
  return points;
}

// Groups a chained point list into "sheets" — consecutive runs sharing the
// same Angle. Works uniformly whether the points came from the frozen
// Point/X/Y/Z table (which carries its own explicit Angle per row) or from
// multi-block alt-format input (whose Angle was auto-derived per block) —
// either way, a sheet is just a maximal run of constant Angle.
export function groupPointsIntoSheets(points) {
  const sheets = [];
  points.forEach((p, i) => {
    const isNewSheet = i === 0 || (p.sheetIndex !== undefined && p.sheetIndex !== points[i - 1].sheetIndex) || (p.sheetIndex === undefined && p.originalAngleDeg !== points[i - 1].originalAngleDeg);
    if (isNewSheet) {
      sheets.push({ sheetIndex: sheets.length, angleDeg: p.originalAngleDeg, startIndex: i, endIndex: i, meta: p.sheetMeta || null });
    } else {
      sheets[sheets.length - 1].endIndex = i;
    }
  });
  return sheets;
}

// --- Table 1: Point / X / Y / Z key vertices, with the geometry's single
// Origin Global Coordinate (X, Y, Z) carried on every row for convenience,
// plus a per-row in-plane rotation Angle — used when the pipeline route
// crosses sheets whose local axes are reoriented at a shared match-line
// point. Rows may be:
//   Point  X  Y  Z                                            (3 numbers)
//   Point  X  Y  Z  OriginX  OriginY  OriginZ                  (6 numbers)
//   Point  X  Y  Z  OriginX  OriginY  OriginZ  AngleDeg         (7 numbers)
// Legacy 3-number rows default to Origin (0,0,0) and Angle 0, so GlobalX/Y/Z
// equal the local X/Y/Z unchanged. Only the FIRST row's Origin is actually
// used as the seed anchor; every later sheet is anchored by continuity (see
// chainGlobalPositions) rather than by re-reading the Origin column again.
export function parseTable1(text) {
  if (isAltPointFormatText(text)) {
    const blocks = splitIntoBlocks(text)
      .map(parseAltFormatBlock)
      .filter((block) => block.rawPoints.length);
    if (blocks.length > 1) return buildMultiSheetTable1(blocks);
    return chainGlobalPositions(parseAltPointFormat(text));
  }
  const points = [];
  for (const rawLine of splitLines(text)) {
    if (isSeparatorLine(rawLine)) continue;
    const tokens = tokenizeRow(rawLine);
    const numericTokens = tokens.filter(isNumericToken).map(Number);
    const labelTokens = tokens.filter((token) => !isNumericToken(token));
    if (numericTokens.length < 3) continue; // needs at least X Y Z
    let x, y, z, originX, originY, originZ, angleDeg;
    if (numericTokens.length >= 7) {
      [x, y, z, originX, originY, originZ, angleDeg] = numericTokens.slice(0, 7);
    } else if (numericTokens.length === 6) {
      [x, y, z, originX, originY, originZ] = numericTokens.slice(0, 6);
      angleDeg = 0;
    } else {
      [x, y, z] = numericTokens.slice(0, 3);
      originX = 0;
      originY = 0;
      originZ = 0;
      angleDeg = 0;
    }
    const label = labelTokens.join(' ').trim() || `Point ${points.length + 1}`;
    if (/^(point|x|y|z|origin.*|angle.*)$/i.test(label)) continue; // header row
    points.push({ label, x, y, z, originX, originY, originZ, angleDeg, originalAngleDeg: angleDeg });
  }
  return chainGlobalPositions(points);
}

export function table1ToTabText(points) {
  const header = ['Point', 'X', 'Y', 'Z', 'OriginGlobalX', 'OriginGlobalY', 'OriginGlobalZ', 'AngleDeg', 'GlobalX', 'GlobalY', 'GlobalZ'].join('\t');
  const lines = points.map((p) =>
    [p.label, p.x, p.y, p.z, p.originX, p.originY, p.originZ, p.angleDeg, round(p.globalX), round(p.globalY), round(p.globalZ)].join('\t'),
  );
  return [header, ...lines].join('\n');
}

const RADIUS_RE = /^\s*radius\s+(-?[\d.]+)/i;
const START_ANGLE_RE = /start\s*angle\s+(-?[\d.]+)/i;
const END_ANGLE_RE = /end\s*angle\s+(-?[\d.]+)/i;

// True arc length for a curved LWPOLYLINE segment: radius × swept angle.
// The swept angle is |end − start|, wrapped into [0,360); values above 180
// are the minor complement (these dumps list start/end for the drawn arc,
// which is always the small sweep here).
function arcLength(radius, startDeg, endDeg) {
  let sweep = Math.abs(endDeg - startDeg) % 360;
  if (sweep > 180) sweep = 360 - sweep;
  return radius * (sweep * Math.PI) / 180;
}

// Alternative Table 2 input: an AutoCAD LWPOLYLINE "LIST" console dump —
// vertex lines interleaved with per-segment arc metadata (bulge / center /
// radius / start angle / end angle) for curved segments, plus "Press ENTER
// to continue:" pagination noise. The arc block appears AFTER the segment's
// first vertex and BEFORE its second, so we buffer any radius/start/end angle
// seen since the last vertex and, on reaching the next vertex, measure that
// segment as a true arc (radius × swept angle) instead of a straight chord.
// Segments with no arc block fall back to chord distance. Horizontal =
// cumulative along-route distance; Elevation = each vertex's Y value, taken
// as-is (anchoring/offset is applied later by the caller if requested).
function parseTable2AltFormat(text) {
  const rows = [];
  let prev = null;
  let cumulative = 0;
  let pendingArc = {};
  for (const rawLine of splitLines(text)) {
    const radiusMatch = rawLine.match(RADIUS_RE);
    if (radiusMatch) { pendingArc.radius = Number(radiusMatch[1]); continue; }
    const startMatch = rawLine.match(START_ANGLE_RE);
    if (startMatch) { pendingArc.start = Number(startMatch[1]); continue; }
    const endMatch = rawLine.match(END_ANGLE_RE);
    if (endMatch) { pendingArc.end = Number(endMatch[1]); continue; }
    const pointMatch = rawLine.match(AT_POINT_RE);
    if (!pointMatch) continue; // bulge/center lines, "Press ENTER...", header metadata
    const p = { x: Number(pointMatch[1]), y: Number(pointMatch[2]) };
    if (prev) {
      const chord = Math.hypot(p.x - prev.x, p.y - prev.y);
      const useArc = pendingArc.radius != null && pendingArc.start != null && pendingArc.end != null;
      cumulative += useArc ? arcLength(pendingArc.radius, pendingArc.start, pendingArc.end) : chord;
    }
    rows.push({ horizontal: round(cumulative), elevation: p.y });
    prev = p;
    pendingArc = {};
  }
  return rows;
}

// --- Table 2: Horizontal (m) vs Grade Elevation (m) station list ---
export function parseTable2(text) {
  if (isAltPointFormatText(text)) return parseTable2AltFormat(text);
  const rows = [];
  for (const rawLine of splitLines(text)) {
    if (isSeparatorLine(rawLine)) continue;
    const nums = extractNumbers(rawLine);
    if (nums.length < 2) continue;
    const [horizontal, elevation] = nums;
    rows.push({ horizontal, elevation });
  }
  rows.sort((a, b) => a.horizontal - b.horizontal);
  return rows;
}

// --- Table 3: Marker segment lengths / cumulative horizontal distances ---
export function parseTable3(text) {
  let rows = [];
  for (const rawLine of splitLines(text)) {
    if (isSeparatorLine(rawLine)) continue;
    const nums = extractNumbers(rawLine);
    if (!nums.length) continue;
    const tokens = tokenizeRow(rawLine);
    const labelTokens = tokens.filter((t) => !isNumericToken(t));
    const marker = labelTokens.join(' ').trim();
    rows.push({ marker, nums });
  }
  if (rows.length === 1 && rows[0].nums.length > 1) {
    rows = rows[0].nums.map((n) => ({ marker: rows[0].marker, nums: [n] }));
  }
  const allSingle = rows.every((r) => r.nums.length === 1);
  if (allSingle) {
    let cumulative = 0;
    return rows.map((r, i) => {
      cumulative += r.nums[0];
      return { index: i + 1, marker: r.marker, length: r.nums[0], cumulative: round(cumulative) };
    });
  }
  return rows.map((r, i) => ({
    index: i + 1,
    marker: r.marker,
    length: r.nums.length >= 2 ? r.nums[r.nums.length - 2] : r.nums[0],
    cumulative: r.nums[r.nums.length - 1],
  }));
}

// Distance between two Table-1 vertices in the GLOBAL frame — this is what
// makes crossing a match line with a reoriented sheet work: a "Match line"
// row ending one sheet and a "Match line" row starting the next should
// resolve to (near-)identical global coordinates, giving a ~0-length pivot
// segment, while all real segments use true global bearing.
function dist2D(a, b) {
  return Math.hypot(b.globalX - a.globalX, b.globalY - a.globalY);
}

// Builds cumulative-distance segments along the polyline defined by Table 1
// vertices' GLOBAL coordinates.
export function buildSegments(vertices) {
  const segments = [];
  let cumulative = 0;
  for (let i = 1; i < vertices.length; i += 1) {
    const a = vertices[i - 1];
    const b = vertices[i];
    const length = dist2D(a, b);
    const start = cumulative;
    cumulative += length;
    segments.push({
      start,
      end: cumulative,
      length,
      dx: length ? (b.globalX - a.globalX) / length : 0,
      dy: length ? (b.globalY - a.globalY) / length : 0,
      ax: a.globalX,
      ay: a.globalY,
    });
  }
  return segments;
}

export function interpolateXY(segments, horizontal) {
  if (!segments.length) return { x: horizontal, y: 0 };
  if (horizontal <= segments[0].start) {
    const s = segments[0];
    return { x: s.ax, y: s.ay };
  }
  const last = segments[segments.length - 1];
  if (horizontal >= last.end) {
    const local = horizontal - last.start;
    return { x: last.ax + local * last.dx, y: last.ay + local * last.dy };
  }
  const seg = segments.find((s) => horizontal >= s.start && horizontal <= s.end) || last;
  const local = horizontal - seg.start;
  return { x: seg.ax + local * seg.dx, y: seg.ay + local * seg.dy };
}

export function interpolateElevation(table2Rows, horizontal) {
  if (!table2Rows.length) return 0;
  if (horizontal <= table2Rows[0].horizontal) return table2Rows[0].elevation;
  const last = table2Rows[table2Rows.length - 1];
  if (horizontal >= last.horizontal) return last.elevation;
  for (let i = 1; i < table2Rows.length; i += 1) {
    const a = table2Rows[i - 1];
    const b = table2Rows[i];
    if (horizontal >= a.horizontal && horizontal <= b.horizontal) {
      const span = b.horizontal - a.horizontal;
      const t = span ? (horizontal - a.horizontal) / span : 0;
      return a.elevation + t * (b.elevation - a.elevation);
    }
  }
  return last.elevation;
}

function addPoint(map, horizontal, x, y, z, label, source) {
  const key = round(horizontal, 2).toFixed(2);
  const existing = map.get(key);
  if (existing) {
    if (label && !existing.label) existing.label = label;
    else if (label && existing.label && !existing.label.includes(label)) existing.label = `${existing.label} / ${label}`;
    if (z != null && existing.z == null) existing.z = z;
    if (existing.source !== 'vertex' && source === 'vertex') existing.source = source;
    return;
  }
  map.set(key, { horizontal: round(horizontal, 2), x: round(x), y: round(y), z: z == null ? null : round(z), label: label || '', source });
}

// Merges the 3 tables into one sorted, de-duplicated coordinate list.
export function buildCombinedCoordinateTable({ table1Text, table2Text, table3Text }) {
  const vertices = parseTable1(table1Text);
  const stations = parseTable2(table2Text);
  const markers = parseTable3(table3Text);
  const segments = buildSegments(vertices);

  const points = new Map();
  let cumulative = 0;
  vertices.forEach((v, i) => {
    if (i > 0) cumulative += dist2D(vertices[i - 1], v);
    addPoint(points, cumulative, v.globalX, v.globalY, null, v.label, 'vertex');
  });
  stations.forEach((row) => {
    const xy = interpolateXY(segments, row.horizontal);
    addPoint(points, row.horizontal, xy.x, xy.y, row.elevation, '', 'table2');
  });
  markers.forEach((row) => {
    const xy = interpolateXY(segments, row.cumulative);
    const markerLabel = row.marker ? row.marker : `Marker ${row.index}`;
    addPoint(points, row.cumulative, xy.x, xy.y, null, markerLabel, 'marker');
  });

  const sorted = [...points.values()].sort((a, b) => a.horizontal - b.horizontal);
  sorted.forEach((p) => {
    if (p.z == null) p.z = round(interpolateElevation(stations, p.horizontal));
    if (!p.label) p.label = `STA ${p.horizontal.toFixed(1)}`;
  });
  return sorted;
}

export const _internal = { splitLines, extractNumbers, dist2D };
