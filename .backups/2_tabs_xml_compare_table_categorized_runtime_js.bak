function generalAction(action, event) { if (action === 'add-source') { setSources(addSource({ sources: state.sources, activeSourceId: state.activeSourceId })); renderShell(); return; } if (action === 'remove-source') { setSources(removeSource({ sources: state.sources, activeSourceId: state.activeSourceId }, state.activeSourceId)); resetDerived(); renderShell(); return; } if (action === 'rename-source' || action === 'parse') { parseActiveSource(); return; } if (action === 'clear') return clearActive(); if (action === 'load-sample') return loadSample(); if (action === 'load-field-comparison-sample') return loadFieldComparisonSample(); if (action === 'load-coordinate-sample') return loadCoordinateSample(); if (action === 'load-two-source-template') return loadTwoSourceTemplate(); if (action === 'confirm-columns') return confirmColumns(); if (action === 'build-graph') return buildGraph(); if (action === 'use-current-graph-source-canvas') return useCurrentGraphAsSourceCanvas(); if (action === 'use-imported-graph-target-canvas') return useImportedGraphAsTargetCanvas(); if (action === 'run-graph-compare-canvas') return runGraphCompareCanvas(); if (action === 'build-graph-connectors') return buildGraphConnectors(); if (action === 'download-graph-connectors-json') return downloadGraphConnectorsJson(); if (action === 'clear-compare-canvas-preview') return clearCompareCanvasPreview(); if (action === 'send-source') return sendToCanvas('source'); if (action === 'send-target') return sendToCanvas('target'); if (action === 'cancel-canvas-handoff') return cancelCanvasHandoff(); if (action === 'confirm-canvas-handoff') return confirmCanvasHandoff(); if (action === 'new-blank-profile' || action === 'reset-profile') return loadBlankProfile(); if (action === 'load-ps-template') return loadPsTemplate(); if (action === 'load-suggested-profile') { const i = Number(event.target.closest('[data-suggestion-index]')?.dataset.suggestionIndex), suggestions = generateSuggestedProfiles(activeSourc