export function createEmptyCompareCanvasState() { return { sourceGraph: null, targetGraph: null, sourceCanvasModel: null, targetCanvasModel: null, graphCompareResult: null, graphConnectors: null, importedTargetGraphName: '', status: '', diagnostics: [] }; }
export function compareCanvasDiagnostic(severity, code, message, details = {}) { return Object.freeze({ severity, code, message, details: Object.freeze(details || {}) }); }
export function validateImportedTargetGraph(graph) { return Boolean(graph && typeof graph === 'object' && Array.isArray(graph.nodes) && Array.isArray(graph.edges)); }
export function createCompareCanvasSourceModel(compareCanvas, graph) { if (!graph) return withCompareDiagnostic(compareCanvas, 'WARNING', 'compare_canvas_source_graph_missing', 'Build a graph before creating Source canvas model.'); const model = createCategorizedGraphCanvasModel({ graph, side: 'source', title: 'Source Graph' }); return appendModelDiagnostics({ ...compareCanvas, sourceGraph: graph, sourceCanvasModel: model, graphCompareResult: null, graphConnectors: null, status: 'Source canvas model created.' }, model); }
export function importCompareCanvasTargetGraphFromText(compareCanvas, text, fileName = 'categorizedGraph.json') { let parsed = null; try { parsed = JSON.parse(String(text || '')); } catch (error) { return withCompareDiagnostic(compareCanvas, 'ERROR', 'compare_canvas_target_json_parse_failed', 'Target graph import failed.', { fileName, error: String(error?.message || error) }); } if (!validateImportedTargetGraph(parsed)) return withCompareDiagnostic(compareCanvas, 'ERROR', 'compare_canvas_target_json_invalid', 'Target graph import failed.', { fileName }); return { ...compareCanvas, targetGraph: parsed, targetCanvasModel: null, graphCompareResult: null, graphConnectors: null, importedTargetGraphName: fileName, status: 'Target graph imported.', diagnostics: [...(compareCanvas?.diagnostics || []), compareCanvasDiagnostic('INFO', 'compare_canvas_target_graph_imported', 'Target graph imported.', { fileName, nodeCount: parsed.nodes.length, edgeCount: parsed.edges.length })] }; }
export function createCompareCanvasTargetModel(compareCanvas) { if (!compareCanvas?.targetGraph) return withCompareDiagnostic(compareCanvas, 'WARNING', 'compare_canvas_target_graph_missing', 'Import target graph before creating Target canvas model.'); const model = createCategorizedGraphCanvasModel({ graph: compareCanvas.targetGraph, side: 'target', title: 'Target Graph' }); return appendModelDiagnostics({ ...compareCanvas, targetCanvasModel: model, graphConnectors: null, status: 'Target canvas model created.' }, model); }
export function runCompareCanvasGraphCompare(compareCanvas) { if (!compareCanvas?.sourceGraph) return withCompareDiagnostic(compareCanvas, 'WARNING', 'compare_canvas_source_graph_missing', 'Create Source canvas model before running graph compare.'); if (!compareCanvas?.targetGraph) return withCompareDiagnostic(compareCanvas, 'WARNING', 'compare_canvas_target_graph_missing', 'Import target graph before running graph compare.'); const result = comparePsMappingCategorizedGraphs({ sourceGraph: compareCanvas.sourceGraph, targetGraph: compareCanvas.targetGraph }); return { ...compareCanvas, graphCompareResult: result, graphConnectors: null, status: 'Graph compare completed.', diagnostics: [...(compareCanvas?.diagnostics || []), compareCanvasDiagnostic('INFO', 'compare_canvas_graph_compare_completed', 'Graph compare completed.', { mapped: result.summary?.mapped || 0 })] }; }
export function buildCompareCanvasGraphConnectors(compareCanvas) { if (!compareCanvas?.sourceCanvasModel) return withCompareDiagnostic(compareCanvas, 'WARNING', 'compare_canvas_source_graph_missing', 'Create Source canvas model before building graph connectors.'); if (!compareCanvas?.targetCanvasModel) return withCompareDiagnostic(compareCanvas, 'WARNING', 'compare_canvas_target_graph_missing', 'Create Target canvas model before building graph connectors.'); if (!compareCanvas?.graphCompareResult) return withCompareDiagnostic(compareCanvas, 'WARNING', 'compare_canvas_graph_compare_missing', 'Run graph compare before building graph connectors.'); const result = buildCategorizedGraphConnectors({ sourceCanvasModel: compareCanvas.sourceCanvasModel, targetCanvasModel: compareCanvas.targetCanvasModel, graphCompareResult: compareCanvas.graphCompareResult }); return { ...compareCanvas, graphConnectors: result, status: 'Graph connectors built.', diagnostics: [...(compareCanvas?.diagnostics || []), compareCanvasDiagnostic('INFO', 'compare_canvas_connector_build_completed', 'Graph connectors built.', { matchCount: result.matchMap?.matches?.length || 0 }), ...(result.diagnostics || [])] }; }
export function summarizeCompareCanvasPreview(compareCanvas = createEmptyCompareCanvasState()) { const c = compareCanvas.graphConnectors, m = c?.matchMap?.matches || [], k = c?.connectorCandidates?.candidates || []; return { sourceRecords: compareCanvas.sourceCanvasModel?.records?.length || 0, targetRecords: compareCanvas.targetCanvasModel?.records?.length || 0, mappedConnectors: m.filter((x) => x.matchType === 'MATCHED').length, mismatchConnectors: m.filter((x) => x.matchType === 'MISMATCH').length, missingMarkers: k.filter((x) => x.matchType === 'MISSING_IN_TARGET').length, extraMarkers: k.filter((x) => x.matchType === 'EXTRA_IN_TARGET').length, diagnostics: (compareCanvas.diagnostics || []).length }; }
export function previewConnectorRows(compareCanvas = createEmptyCompareCanvasState(), limit = 20) { const c = compareCanvas.graphConnectors; return [...(c?.matchMap?.matches || []), ...(c?.connectorCandidates?.candidates || [])].slice(0, limit); }
export function createDefaultPivotOutputView(fieldCatalog = {}, existing = []) { const fields = fieldCatalog.fields || [], ids = new Set((existing || []).map((v) => v.viewId)); let i = 1; while (ids.has(`pivotView${i}`)) i += 1; const row = fields.find((f) => ['key', 'group'].includes(f.role)) || fields[0], col = fields.find((f) => f.fieldId !== row?.fieldId && f.role === 'group') || fields.find((f) => f.fieldId !== row?.fieldId) || row, val = fields.find((f) => f.type === 'number') || fields[0], agg = val?.type === 'number' ? 'sum' : 'count'; return { schema: 'OutputView.v1', viewId: `pivotView${i}`, type: 'pivot', displayName: `Pivot View ${i}`, enabled: true, pivotSpec: { schema: 'PivotSpec.v1', filters: [], rows: row ? [fieldRefObj(row)] : [], columns: col ? [fieldRefObj(col)] : [], values: val ? [valueRefObj(val, agg)] : [] } }; }
export function updatePivotOutputViews(views = [], viewId = '', patch = {}, fieldCatalog = {}) { return (views || []).map((view) => view.viewId === viewId ? patchPivotView(view, patch, fieldCatalog) : view); }
export function removePivotOutputView(views = [], viewId = '') { const next = (views || []).filter((view) => view.viewId !== viewId); return { outputViews: next, activePivotViewId: next[0]?.viewId || '' }; }
export function safePivotFileStem(viewId = 'pivotView') { return String(viewId || 'pivotView').trim().replace(/[^A-Za-z0-9._-]+/g, '_') || 'pivotView'; }
export function createPivotDownloadArtifact({ graph = null, outputView = null, fieldCatalog = null, kind = 'json' } = {}) { const diagnostics = guardedPivotDiagnostics(graph, outputView, fieldCatalog); if (hasBlockingDiagnostics(diagnostics)) return pivotArtifact(false, '', '', '', diagnostics); const model = buildPivotViewModel({ graph, pivotSpec: outputView.pivotSpec, fieldCatalog }); diagnostics.push(...(model.diagnostics || [])); if (hasBlockingDiagnostics(diagnostics)) return pivotArtifact(false, '', '', '', diagnostics); const artifacts = exportPivotViewModelArtifacts(model), item = artifacts[kind]; if (!item?.ok) return pivotArtifact(false, '', '', '', [...diagnostics, ...(item?.diagnostics || [])]); const ext = { json: 'json', csv: 'csv', html: 'html' }[kind] || kind, type = { json: 'application/json;charset=utf-8', csv: 'text/csv;charset=utf-8', html: 'text/html;charset=utf-8' }[kind] || 'text/plain;charset=utf-8'; return pivotArtifact(true, `${safePivotFileStem(outputView.viewId)}.pivot.${ext}`, item.text, type, diagnostics); }
function guardedPivotDiagnostics(graph, outputView, fieldCatalog) { const out = []; if (!outputView) out.push(pivotDiag('pivot_view_missing', 'Select a pivot view before downloading.')); if (!fieldCatalog?.fields?.length) out.push(pivotDiag('pivot_field_catalog_missing', 'FieldCatalog fields are required before pivot download.')); if (!graph) out.push(pivotDiag('pivot_graph_missing', 'Build graph before pivot download.')); const fields = new Set((fieldCatalog?.fields || []).map((field) => field.fieldId)); for (const filter of outputView?.pivotSpec?.filters || []) if (!filter?.fieldId || !fields.has(filter.fieldId)) out.push(pivotDiag('pivot_filter_field_missing', 'Pivot filter requires a FieldCatalog field.')); return out; }
function patchPivotView(view, patch, fieldCatalog) { const fields = new Map((fieldCatalog.fields || []).map((f) => [f.fieldId, f])), next = normalizePivotView(view), spec = next.pivotSpec; if ('displayName' in patch) next.displayName = patch.displayName; if ('enabled' in patch) next.enabled = Boolean(patch.enabled); if ('rowFieldId' in patch) patchZoneField(spec.rows, Number(patch.index || 0), patch.rowFieldId, fields); if ('columnFieldId' in patch) patchZoneField(spec.columns, Number(patch.index || 0), patch.columnFieldId, fields); if ('valueFieldId' in patch) patchValueField(spec.values, Number(patch.index || 0), patch.valueFieldId, fields); if ('aggregate' in patch) patchValueAggregate(spec.values, Number(patch.index || 0), patch.aggregate, fields); if ('filterFieldId' in patch || 'filterOperator' in patch || 'filterValue' in patch) patchFilter(spec.filters, Number(patch.index || 0), patch); if (patch.action === 'add-row') addZoneField(spec.rows, fields); if (patch.action === 'add-column') addZoneField(spec.columns, fields); if (patch.action === 'add-value') addValueField(spec.values, fields); if (patch.action === 'remove-row') spec.rows.splice(Number(patch.index), 1); if (patch.action === 'remove-column') spec.columns.splice(Number(patch.index), 1); if (patch.action === 'remove-value') spec.values.splice(Number(patch.index), 1); if (patch.action === 'add-filter') spec.filters.push(encodeFilter({ fieldId: [...fields.values()][0]?.fieldId || '', operator: 'equals', value: '' })); if (patch.action === 'remove-filter') spec.filters.splice(Number(patch.index), 1); return next; }
function normalizePivotView(view) { return { ...view, pivotSpec: { ...(view.pivotSpec || {}), filters: [...(view.pivotSpec?.filters || [])], rows: [...(view.pivotSpec?.rows || [])], columns: [...(view.pivotSpec?.columns || [])], values: [...(view.pivotSpec?.values || [])] } }; }
function addZoneField(items, fields) { const field = firstUnusedField(items, fields) || [...fields.values()][0]; if (field) items.push(fieldRefObj(field)); }
function patchZoneField(items, index, fieldId, fields) { const f = fields.get(fieldId); if (f) items[index] = fieldRefObj(f); else items.splice(index, 1); }
function addValueField(items, fields) { const field = firstUnusedField(items, fields) || [...fields.values()][0]; if (field) items.push(valueRefObj(field, field.type === 'number' ? 'sum' : 'count')); }
function patchValueField(items, index, fieldId, fields) { const f = fields.get(fieldId); if (!f) { items.splice(index, 1); return; } const aggregate = items[index]?.aggregate || (f.type === 'number' ? 'sum' : 'count'); items[index] = valueRefObj(f, aggregate); }
function patchValueAggregate(items, index, aggregate, fields) { if (!items[index]) return; const f = fields.get(items[index].fieldId); items[index] = valueRefObj(f || { fieldId: items[index].fieldId, label: items[index].fieldId }, aggregate); }
function patchFilter(items, index, patch) { const current = items[index] || {}, fieldId = 'filterFieldId' in patch ? patch.filterFieldId : current.fieldId, operator = patch.filterOperator || current.operator || filterOperator(current), value = 'filterValue' in patch ? patch.filterValue : filterValue(current); items[index] = encodeFilter({ fieldId, operator, value }); }
function encodeFilter({ fieldId = '', operator = 'equals', value = '' } = {}) { const out = { fieldId, operator }; if (operator === 'notEquals') out.notEquals = value; else if (operator === 'contains' || operator === 'notContains') out[operator] = value; else if (operator === 'blank' || operator === 'notBlank') out.value = ''; else out.equals = value; return out; }
function filterOperator(filter = {}) { if ('notEquals' in filter) return 'notEquals'; if ('contains' in filter) return 'contains'; if ('notContains' in filter) return 'notContains'; if (filter.operator) return filter.operator; if ('equals' in filter || 'value' in filter) return 'equals'; return 'notBlank'; }
function filterValue(filter = {}) { return filter.equals ?? filter.notEquals ?? filter.contains ?? filter.notContains ?? filter.value ?? ''; }
function firstUnusedField(items, fields) { const used = new Set((items || []).map((item) => item.fieldId)); return [...fields.values()].find((field) => !used.has(field.fieldId)); }
function fieldRefObj(field) { return { fieldId: field.fieldId, label: field.label }; }
function valueRefObj(field, aggregate) { return { fieldId: field.fieldId, aggregate, label: `${field.label || field.fieldId} ${aggregate}` }; }
function pivotDiag(code, message) { return Object.freeze({ gate: code, severity: 'BLOCKER', status: 'FAIL', code, message }); }
function hasBlockingDiagnostics(items = []) { return items.some((d) => ['BLOCKER', 'ERROR'].includes(d?.severity)); }
function pivotArtifact(ok, name, text, type, diagnostics) { return Object.freeze({ ok, name, text, type, diagnostics: Object.freeze(diagnostics) }); }
function withCompareDiagnostic(compareCanvas, severity, code, message, details = {}) { return { ...compareCanvas, status: message, diagnostics: [...(compareCanvas?.diagnostics || []), compareCanvasDiagnostic(severity, code, message, details)] }; }
function appendModelDiagnostics(compareCanvas, model) { return { ...compareCanvas, diagnostics: [...(compareCanvas?.diagnostics || []), ...(model?.diagnostics || [])] }; }
function injectStyle(doc = globalThis.document) { if (!doc) return; let style = doc.getElementById(STYLE_ID); if (!style) { style = doc.createElement('style'); style.id = STYLE_ID; doc.head?.append(style); } if (style) style.textContent = '.table-categorized-xml-backdrop{position:fixed;inset:0;z-index:72;background:rgba(2,6,23,.72);display:grid;place-items:center}.table-categorized-xml-dialog{width:min(1220px,calc(100vw - 28px));height:min(840px,calc(100vh - 28px));display:grid;grid-template-rows:auto auto 1fr;border:1px solid #38bdf8;border-radius:18px;background:#0f172a;color:#dbeafe;overflow:hidden}.table-categorized-shell-split{display:grid;grid-template-columns:minmax(0,1fr) minmax(320px,.42fr);gap:12px;padding:12px;overflow:auto}.table-categorized-shell-side-card{border:1px solid rgba(148,163,184,.18);border-radius:14px;background:rgba(2,6,23,.34);padding:12px;display:flex;flex-direction:column;gap:10px}.table-categorized-stepper{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:8px;padding:10px}.table-categorized-tree-node{border:1px solid rgba(148,163,184,.16);border-radius:10px;padding:8px;margin:4px}.table-categorized-tree-node.is-selected{border-color:#0ea5e9}.table-categorized-xml-dialog button,.table-categorized-file{border:1px solid rgba(125,211,252,.35);border-radius:10px;background:rgba(30,41,59,.92);color:#e0f2fe;padding:7px 10px;font-weight:800}.table-categorized-xml-dialog input,.table-categorized-xml-dialog textarea,.table-categorized-xml-dialog select{background:#020617;color:#dbeafe;border:1px solid rgba(96,165,250,.25);border-radius:8px;padding:6px}.table-categorized-xml-dialog table{width:100%;border-collapse:collapse}.table-categorized-xml-dialog th,.table-categorized-xml-dialog td{border-bottom:1px solid rgba(148,163,184,.13);padding:7px;text-align:left}'; }
function setActiveTab(tab) { state.activeTab = TAB_TO_STEP[tab] ? tab : 'source'; state.activeStep = TAB_TO_STEP[state.activeTab]; }
function setActiveStep(step) { state.activeStep = STEP_TO_TAB[step] ? step : 'table'; state.activeTab = STEP_TO_TAB[state.activeStep]; }
function openShell() { injectStyle(); document.querySelector(POPUP_SELECTOR)?.remove(); document.body.insertAdjacentHTML('beforeend', renderTableCategorizedXmlShellHtml({ ...state, generateLivePreview })); }
function closeShell() { document.querySelector(POPUP_SELECTOR)?.remove(); }
function renderShell() { if (document.querySelector(POPUP_SELECTOR)) openShell(); }
function injectButton(doc = globalThis.document) { if (!doc) return; const toolbar = doc.querySelector('.xml-compare-tab .xml-compare-toolbar'); if (!toolbar || toolbar.querySelector(BUTTON_SELECTOR)) return; injectStyle(doc); const linewise = toolbar.querySelector('[data-xml-compare-categorized-open]'); if (linewise) linewise.insertAdjacentHTML('afterend', renderTableCategorizedXmlButtonHtml()); else toolbar.insertAdjacentHTML('beforeend', renderTableCategorizedXmlButtonHtml()); }
function resetDerived() { state.columnsConfirmed = false; state.graph = null; state.validationResults = []; state.exportResult = null; state.exportStatus = ''; state.pendingHandoff = null; state.compareCanvas = createEmptyCompareCanvasState(); }
function setSources(next) { state.sources = [...next.sources]; state.activeSourceId = next.activeSourceId; }
function active() { return activeSource({ sources: state.sources, activeSourceId: state.activeSourceId }); }
function activeCatalog() { return buildFieldCatalog([active() || {}]); }
function applyIsoRecipeTemplateIfNeeded() { const headers = active()?.headers || []; if (headers.includes('SupportISONOTE') && !headers.includes('PS NO')) { state.profile = ISO_NOTE_RECIPE_PROFILE; state.selectedLevelPath = '0'; state.activePivotViewId = ''; state.profileValidation = []; state.exportStatus = 'ISOrecipe template applied for SupportISONOTE table.'; return true; } return false; }
function parseActiveSource(step = 'source') { setSources(parseSourceDraft({ sources: state.sources, activeSourceId: state.activeSourceId }, state.activeSourceId)); resetDerived(); const appliedIso = applyIsoRecipeTemplateIfNeeded(); if (!appliedIso) state.exportStatus = ''; setActiveTab(step); renderShell(); }
function confirmColumns() { if (!active()?.rows?.length) { state.columnsConfirmed = false; state.exportStatus = 'Read a table before confirming columns.'; setActiveTab('levels'); renderShell(); return; } state.columnsConfirmed = true; state.profileValidation = []; state.exportStatus = 'Columns confirmed.'; setActiveTab('graph'); renderShell(); }
function buildGraph() { const parsedSources = state.sources.filter((s) => s.rows?.length); state.profileValidation = validateEditableProfile(state.profile, { sources: parsedSources }); if (hasProfileBlockers(state.profileValidation)) { state.validationResults = state.profileValidation; state.exportResult = null; state.exportStatus = 'Graph build blocked by profile validation.'; setActiveTab('validation'); renderShell(); return; } state.graph = buildCategorizedGraph(state.profile, parsedSources); state.validationResults = [...state.profileValidation, ...runCategorizerValidation({ profile: state.profile, sources: parsedSources, graph: state.graph })]; state.exportResult = exportCategorizedGraphArtifacts({ graph: state.graph, profile: state.profile, validationResults: state.validationResults, sources: parsedSources }); state.exportStatus = state.exportResult.ok ? 'Graph built and XML artifacts are ready.' : 'Graph built, but export is blocked.'; setActiveTab('validation'); renderShell(); }
function loadSample() { let next = updateSourceDraft({ sources: state.sources, activeSourceId: state.activeSourceId }, state.activeSourceId, { sourceName: 'PS Mapping Table 2 Sample', sourceText: PS_MAPPING_TABLE_2_SAMPLE, sourceType: 'sample' }); setSources(parseSourceDraft(next, state.activeSourceId)); resetDerived(); setActiveTab('source'); renderShell(); }
function loadFieldComparisonSample() { state.profile = FIELD_COMPARISON_SAMPLE_PROFILE; state.selectedLevelPath = '0'; state.activePivotViewId = ''; let next = createMultiSourceState(); next = updateSourceDraft(next, 'S1', { sourceName: 'Field-level Comparison Sample', sourceText: FIELD_COMPARISON_SAMPLE, sourceType: 'sample', delimiterMode: 'tab' }); next = parseSourceDraft(next, 'S1'); setSources(setActiveSource(next, 'S1')); resetDerived(); state.exportStatus = 'Loaded field-comparison sample and custom recipe. Confirm columns, then build graph.'; setActiveTab('levels'); renderShell(); }
function loadCoordinateSample() { let next = { sources: state.sources, activeSourceId: state.activeSourceId }; if (!next.sources.some((s) => s.sourceId === 'S2')) next = addSource(next, 'Coordinate Lookup'); next = setActiveSource(next, 'S2'); next = updateSourceDraft(next, 'S2', { sourceName: 'Coordinate Lookup Sample', sourceText: PS_MAPPING_COORDINATE_LOOKUP_SAMPLE, sourceType: 'pasteText' }); setSources(parseSourceDraft(next, 'S2')); resetDerived(); setActiveTab('source'); renderShell(); }
function loadTwoSourceTemplate() { state.profile = PS_MAPPING_TABLE_2_COORDINATE_LOOKUP_PROFILE; state.activePivotViewId = ''; let next = createMultiSourceState(); next = updateSourceDraft(next, 'S1', { sourceName: 'PS Mapping Table 2 Model Sample', sourceText: PS_MAPPING_TABLE_2_MODEL_SAMPLE }); next = parseSourceDraft(next, 'S1'); next = addSource(next, 'Coordinate Lookup'); next = updateSourceDraft(next, 'S2', { sourceName: 'Coordinate Lookup Sample', sourceText: PS_MAPPING_COORDINATE_LOOKUP_SAMPLE }); next = parseSourceDraft(next, 'S2'); setSources(setActiveSource(next, 'S1')); resetDerived(); setActiveTab('levels'); renderShell(); }
function clearActive() { const a = active(); setSources(updateSourceDraft({ sources: state.sources, activeSourceId: state.activeSourceId }, state.activeSourceId, { ...a, sourceText: '', headers: [], rows: [], diagnostics: [], transformRules: [] })); resetDerived(); renderShell(); }
function applyProfileChanges() { const root = document.querySelector(POPUP_SELECTOR); if (!root) return; let p = updateProfileHeader(state.profile, { profileId: value(root, '[data-profile-field="profileId"]'), displayName: value(root, '[data-profile-field="displayName"]') }); const parentNames = names(root, '[data-parent-name]').slice(0, 3); if (parentNames.length) p = setChildrenNames(p, [0, 0], parentNames, { levelType: 'group', creationMode: 'one-per-key', keyColumn: active()?.headers?.[0] || 'PS NO' }); state.profile = p; state.profileValidation = validateEditableProfile(state.profile, { sources: state.sources.filter((s) => s.rows?.length) }); resetDerived(); state.exportStatus = 'Profile changes applied.'; setActiveTab('levels'); renderShell(); }
function names(root, selector) { return [...root.querySelectorAll(selector)].map((input) => input.value).filter(Boolean); }
function value(root, selector) { return String(root.querySelector(selector)?.value || ''); }
function loadBlankProfile() { state.profile = createBlankUniversalProfile(); state.selectedLevelPath = '0'; state.activePivotViewId = ''; state.profileValidation = []; resetDerived(); setActiveTab('levels'); renderShell(); }
function loadPsTemplate() { state.profile = createPsMappingTable2TemplateProfile(); state.selectedLevelPath = '0'; state.activePivotViewId = ''; state.profileValidation = []; resetDerived(); setActiveTab('levels'); renderShell(); }
