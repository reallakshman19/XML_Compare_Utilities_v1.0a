function clickHandler(event) { if (event.target.closest(BUTTON_SELECTOR)) { event.preventDefault(); openShell(); return; } if (event.target.closest('[data-table-categorized-close]')) { event.preventDefault(); closeShell(); return; } const step = event.target.closest('[data-table-categorized-step]')?.dataset.tableCategorizedStep; if (step) { event.preventDefault(); setActiveStep(step); renderShell(); return; } const tab = event.target.closest('[data-table-categorized-tab]')?.dataset.tableCategorizedTab; if (tab) { event.preventDefault(); setActiveTab(tab); renderShell(); return; } const download = event.target.closest('[data-table-categorized-download]')?.dataset.tableCategorizedDownload; if (download) { event.preventDefault(); downloadArtifact(download); return; } const action = event.target.closest('[data-table-categorized-action]')?.dataset.tableCategorizedAction; if (!action) return; if (['assign-field-key', 'assign-field-display', 'add-field-resolver', 'create-child-from-field'].includes(action)) return void (event.preventDefault(), applyGuidedFieldAction(action, event)); if (action === 'select-level') return void (event.preventDefault(), selectLevelFromButton(event)); if (action === 'add-child-level') return void (event.preventDefault(), addChildFromButton(event)); if (action === 'remove-level') return void (event.preventDefault(), removeLevelFromButton(event)); if (action === 'add-pivot-view') return void (event.preventDefault(), addPivotView()); if (action === 'select-pivot-view') return void (event.preventDefault(), selectPivotView(event)); if (action === 'remove-pivot-view') return void (event.preventDefault(), removeActivePivotView()); if (action.startsWith('download-pivot-')) return void (event.preventDefault(), downloadPivot(action.replace('download-pivot-', ''))); if (action.includes('pivot-row') || action.includes('pivot-column') || action.includes('pivot-value') || action.includes('pivot-filter')) return void (event.preventDefault(), pivotZoneAction(a