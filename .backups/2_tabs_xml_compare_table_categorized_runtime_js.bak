function defaultTransformRule() { const h = active()?.headers || [], hasPs = h.includes('PS NO'); return createSourceTransformRule(hasPs ? { newColumn: 'PS_NO_Trimmed', sourceColumn: 'PS NO', operation: 'take-before', find: '.', replaceWith: '' } : { newColumn: 'New_Column', sourceColumn: h[0] || '', operation: 'trim', find: '', replaceWith: '' }); }
