function artifactForKind(kind) { const r = state.exportResult; if (kind === 'profile') return { name: 'profile.json', text: serializeProfile(state.profile), type: 'application/json;charset=utf-8' }; if (!r?.ok) return null; if (kind === 'xml') return { name: 'categorized.xml', text: r.xmlText, type: 'application/xml;charset=utf-8' }; if (kind === 'graph') return { name: 'categorizedGraph.json', text: r.graphJson, type: 'application/json;charset=utf-8' }; if (kind === 'diagnostics') return { name: 'diagnostics.json', text: r.diagnosticsJson, type: 'application/json;charset=utf-8' }; if (kind === 'audit') return { name: 'audit.json', text: r.auditJson, type: 'application/json;charset=utf-8' }; return null; }
