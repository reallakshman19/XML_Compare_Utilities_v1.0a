function fieldActionButton(event) { return event.target.closest('[data-field-header]'); }
function cleanName(value, fallback = 'Field') { const text = String(value || fallback).trim(); return text.replace(/[^A-Za-z0-9]+/g, ' ').trim().replace(/\s+(.)/g, (_, c) => c.toUpperCase()).replace(/^./, (c) => c.toLowerCase()) || fallback; }
