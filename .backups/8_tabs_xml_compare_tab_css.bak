/* XML Compare tab styles */

.xml-compare-tab {
  display: flex;
  flex-direction: column;
  height: 100%;
  min-height: 0;
  overflow: hidden;
  background: #0b1220;
  color: #dbeafe;
}

.xml-compare-header {
  padding: 16px 18px 12px;
  border-bottom: 1px solid rgba(148, 163, 184, 0.18);
  background: linear-gradient(180deg, rgba(15, 23, 42, 0.96), rgba(11, 18, 32, 0.96));
}

.xml-compare-header h2 { margin: 0 0 6px; font-size: 22px; letter-spacing: 0.01em; }
.xml-compare-header p { margin: 0; max-width: 980px; color: #94a3b8; line-height: 1.45; }
.xml-compare-toolbar { display: flex; flex-wrap: wrap; gap: 8px; padding: 10px 12px; border-bottom: 1px solid rgba(148, 163, 184, 0.18); background: #0f172a; }
.xml-compare-file-btn { display: inline-flex; align-items: center; gap: 8px; padding: 8px 10px; border: 1px solid rgba(96, 165, 250, 0.32); border-radius: 8px; background: #111827; color: #dbeafe; font-size: 12px; cursor: pointer; }
.xml-compare-file-btn input { max-width: 180px; color: #cbd5e1; }
.xml-compare-file-btn.is-loaded { border-color: rgba(34,197,94,.55); background: rgba(20,83,45,.28); color: #bbf7d0; max-width: 260px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.xml-compare-toolbar button,
.xml-compare-topology-actions button { padding: 7px 10px; border: 1px solid rgba(96, 165, 250, 0.32); border-radius: 8px; background: #1e293b; color: #dbeafe; font-size: 12px; cursor: pointer; }
.xml-compare-toolbar button:hover,
.xml-compare-topology-actions button:hover { background: #334155; }
.xml-compare-toolbar button:disabled { opacity: 0.45; cursor: not-allowed; }
.xml-compare-status { padding: 10px 12px; font-size: 12px; border-bottom: 1px solid rgba(148, 163, 184, 0.12); }
.xml-compare-status.ok { color: #bbf7d0; background: rgba(20, 83, 45, 0.24); }
.xml-compare-status.warn { color: #fef3c7; background: rgba(120, 53, 15, 0.24); }
.xml-compare-status.error { color: #fecaca; background: rgba(127, 29, 29, 0.24); }
.xml-compare-layout { display: grid; grid-template-columns: 0.92fr 1.2fr 0.88fr; gap: 12px; padding: 12px; min-height: 0; flex: 1; }
.xml-compare-panel { display: flex; flex-direction: column; min-height: 0; overflow: hidden; border: 1px solid rgba(148, 163, 184, 0.16); border-radius: 12px; background: rgba(15, 23, 42, 0.72); }
.xml-compare-panel-title { padding: 10px 12px; border-bottom: 1px solid rgba(148, 163, 184, 0.16); color: #bfdbfe; font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.04em; }
.xml-compare-summary-grid,
.xml-compare-detail-card { display: grid; grid-template-columns: 1fr 1fr; gap: 8px 12px; padding: 12px; }
.xml-compare-summary-grid div,
.xml-compare-detail-card div { display: flex; flex-direction: column; gap: 3px; padding: 8px 10px; border: 1px solid rgba(148, 163, 184, 0.12); border-radius: 10px; background: rgba(2, 6, 23, 0.32); }
.xml-compare-summary-grid b,
.xml-compare-detail-card b { color: #93c5fd; font-size: 11px; text-transform: uppercase; letter-spacing: 0.03em; }
.xml-compare-summary-grid span,
.xml-compare-detail-card span { color: #e2e8f0; font-size: 12px; }
.xml-compare-topology-filters { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; padding: 12px; border-bottom: 1px solid rgba(148, 163, 184, 0.14); }
.xml-compare-topology-filters select,
.xml-compare-topology-filters input { min-width: 0; padding: 7px 10px; border: 1px solid rgba(96, 165, 250, 0.22); border-radius: 8px; background: #0b1220; color: #dbeafe; font-size: 12px; }
.xml-compare-topology-filters input { grid-column: 1 / -1; }
.xml-compare-topology-actions { display: flex; flex-wrap: wrap; gap: 8px; padding: 10px 12px; border-bottom: 1px solid rgba(148, 163, 184, 0.14); background: rgba(2, 6, 23, 0.22); }
.xml-compare-topology-filter-summary,
.xml-compare-empty { padding: 10px 12px; color: #94a3b8; font-size: 12px; }
.xml-compare-table-scroll { overflow: auto; }
.xml-compare-topology-table { width: 100%; border-collapse: collapse; font-size: 11px; }
.xml-compare-topology-table th,
.xml-compare-topology-table td { padding: 7px 9px; border-bottom: 1px solid rgba(148, 163, 184, 0.12); text-align: left; vertical-align: top; }
.xml-compare-topology-table th { position: sticky; top: 0; background: #111827; color: #bfdbfe; z-index: 1; }
.xml-compare-topology-table tr.is-selected { outline: 2px solid rgba(96, 165, 250, 0.7); outline-offset: -2px; }
.xml-compare-topology-table tr.topology-error td { color: #fecaca; }
.xml-compare-topology-table tr.topology-warning td { color: #fef3c7; }
.xml-compare-topology-table tr.topology-info td { color: #bbf7d0; }
.xml-compare-topology-table tr.is-hidden { opacity: 0.4; }
.xml-compare-workspace-shell { padding: 12px; border-bottom: 1px solid rgba(148, 163, 184, 0.18); background: rgba(2, 6, 23, 0.24); }
.xml-compare-workspace-grid { display: grid; grid-template-columns: minmax(0, 1fr) 240px minmax(0, 1fr); gap: 10px; }
.xml-compare-workspace-side,
.xml-compare-connector-lane,
.xml-compare-bottom-panel,
.xml-compare-log-screen { border: 1px solid rgba(148, 163, 184, 0.16); border-radius: 12px; background: rgba(15, 23, 42, 0.72); overflow: hidden; }
.xml-compare-workspace-side header,
.xml-compare-connector-lane header,
.xml-compare-bottom-panel header,
.xml-compare-log-screen header { padding: 9px 11px; border-bottom: 1px solid rgba(148, 163, 184, 0.14); color: #bfdbfe; font-size: 12px; font-weight: 800; text-transform: uppercase; }
.xml-compare-side-stage,
.xml-compare-connector-lane div,
.xml-compare-connector-lane small,
.xml-compare-debug-grid,
.xml-compare-log-screen-rows { padding: 10px 12px; color: #cbd5e1; font-size: 12px; }
.xml-compare-side-metrics,
.xml-compare-debug-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; padding: 10px 12px; }
.xmlc-side-picker-card > header { display: flex; justify-content: space-between; gap: 8px; }
.xmlc-side-picker-card > header span { color: #94a3b8; font-size: 11px; text-transform: none; }
.xmlc-side-controls { display: grid; grid-template-columns: minmax(0, 1fr); gap: 8px; padding: 10px 12px 0; }
.xmlc-side-controls.is-empty { display: block; color: #94a3b8; font-size: 12px; padding-bottom: 10px; }
.xmlc-side-controls label { display: grid; gap: 4px; color: #bfdbfe; font-size: 11px; font-weight: 800; text-transform: uppercase; }
.xmlc-side-controls select { min-width: 0; border: 1px solid rgba(96,165,250,.3); border-radius: 8px; background: #020617; color: #dbeafe; padding: 7px 9px; font-size: 12px; text-transform: none; }
.xmlc-side-picker { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 8px; padding: 10px 12px; border-bottom: 1px solid rgba(148,163,184,.12); }
.xmlc-side-picker label { display: grid; gap: 4px; color: #bfdbfe; font-size: 11px; font-weight: 800; text-transform: uppercase; }
.xmlc-side-picker input { min-width: 0; border: 1px solid rgba(96,165,250,.3); border-radius: 8px; background: #020617; color: #dbeafe; padding: 7px 9px; font-size: 12px; text-transform: none; }
.xmlc-side-picker button { align-self: end; border: 1px solid rgba(125,211,252,.35); border-radius: 8px; background: rgba(14,116,144,.5); color: #e0f2fe; padding: 7px 12px; font-weight: 800; cursor: pointer; }
.xmlc-side-label-field { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 8px; padding: 0 12px 10px; border-bottom: 1px solid rgba(148,163,184,.12); }
.xmlc-side-label-field label { display: grid; gap: 4px; color: #bfdbfe; font-size: 11px; font-weight: 800; text-transform: uppercase; }
.xmlc-side-label-field select { min-width: 0; border: 1px solid rgba(96,165,250,.3); border-radius: 8px; background: #020617; color: #dbeafe; padding: 7px 9px; font-size: 12px; text-transform: none; }
.xmlc-side-label-field button { align-self: end; border: 1px solid rgba(125,211,252,.35); border-radius: 8px; background: rgba(14,116,144,.5); color: #e0f2fe; padding: 7px 12px; font-weight: 800; cursor: pointer; }
.xmlc-side-field-strip { display: grid; grid-template-columns: auto minmax(0,1fr); gap: 8px; padding: 8px 12px; border-bottom: 1px solid rgba(148,163,184,.12); color: #cbd5e1; font-size: 11px; }
.xmlc-side-field-strip b { color: #93c5fd; text-transform: uppercase; letter-spacing: .03em; }
.xmlc-side-field-strip span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.xmlc-main-connector { display: grid; gap: 4px; padding: 8px 10px; margin-bottom: 8px; border: 1px solid rgba(125,211,252,.24); border-radius: 10px; background: rgba(8,47,73,.28); }
.xmlc-main-connector.is-empty { color: #94a3b8; font-size: 11px; }
.xmlc-main-connector label { display: grid; gap: 4px; color: #bfdbfe; font-size: 11px; font-weight: 800; text-transform: uppercase; }
.xmlc-main-connector select { min-width: 0; border: 1px solid rgba(96,165,250,.3); border-radius: 8px; background: #020617; color: #dbeafe; padding: 7px 9px; font-size: 12px; text-transform: none; }
.xmlc-main-connector small { color: #94a3b8; font-size: 10px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.xmlc-conn-type { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; align-items: center; }
.xmlc-conn-type span { grid-column: 1 / -1; color: #bfdbfe; font-size: 11px; font-weight: 800; text-transform: uppercase; }
.xmlc-conn-type label { display: inline-flex; align-items: center; justify-content: center; gap: 5px; padding: 6px 8px; border: 1px solid rgba(96,165,250,.28); border-radius: 8px; background: rgba(2,6,23,.44); color: #dbeafe; font-size: 12px; text-transform: none; }
.xmlc-conn-type input { accent-color: #38bdf8; }
.xml-compare-bottom-tabs { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; margin-top: 10px; }
.xml-compare-log-row,
.xml-compare-mini-table td,
.xml-compare-debug-grid div,
.xml-compare-side-metrics div { padding: 6px 8px; border-bottom: 1px solid rgba(148, 163, 184, 0.1); color: #dbeafe; font-size: 11px; }
.xml-compare-canvas-host { margin: 0 12px 12px; border: 1px solid rgba(96, 165, 250, 0.24); border-radius: 12px; background: rgba(2, 6, 23, 0.34); overflow: hidden; }
.xml-compare-canvas-host > header { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 8px 10px; background: rgba(15, 23, 42, 0.8); }
.xml-compare-canvas-host > header span { color: #94a3b8; font-size: 11px; text-transform: none; }
.xml-compare-canvas-toolbar { display: flex; flex-wrap: wrap; gap: 6px; padding: 8px 10px; border-bottom: 1px solid rgba(148, 163, 184, 0.12); }
.xml-compare-canvas-toolbar button { padding: 6px 8px; border: 1px solid rgba(96, 165, 250, 0.28); border-radius: 8px; background: #111827; color: #dbeafe; font-size: 11px; cursor: pointer; }
.xml-compare-canvas-toolbar button.is-active { background: #1d4ed8; border-color: rgba(191, 219, 254, 0.6); }
.xml-compare-canvas-viewport { min-height: 148px; position: relative; display: grid; place-items: center; border-bottom: 1px solid rgba(148, 163, 184, 0.12); background: radial-gradient(circle at center, rgba(59, 130, 246, 0.12), rgba(2, 6, 23, 0.4)); }
.xml-compare-canvas-reticle { width: 78px; height: 78px; display: grid; place-items: center; border: 1px dashed rgba(147, 197, 253, 0.52); border-radius: 999px; color: #93c5fd; font-size: 12px; letter-spacing: 0.08em; }
.xml-compare-canvas-metrics { position: absolute; left: 8px; right: 8px; bottom: 8px; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 6px; }
.xml-compare-canvas-metrics div { padding: 5px 7px; border: 1px solid rgba(148, 163, 184, 0.12); border-radius: 8px; background: rgba(15, 23, 42, 0.74); }
.xml-compare-canvas-metrics b { display: block; color: #93c5fd; font-size: 10px; text-transform: uppercase; }
.xml-compare-canvas-metrics span { color: #e2e8f0; font-size: 11px; }
.xml-compare-hover-card { max-height: 180px; overflow-y: auto; border-top: 1px solid rgba(148,163,184,.14); }
.xml-compare-hover-table { width: 100%; border-collapse: collapse; font-size: 11px; }
.xml-compare-hover-table th, .xml-compare-hover-table td { padding: 5px 9px; border-bottom: 1px solid rgba(148,163,184,.1); vertical-align: top; text-align: left; white-space: nowrap; }
.xml-compare-hover-table th { width: 42%; color: #93c5fd; font-size: 10px; text-transform: uppercase; letter-spacing: .03em; font-weight: 700; background: rgba(2,6,23,.5); position: sticky; left: 0; }
.xml-compare-hover-table td { color: #e2e8f0; font-family: ui-monospace, Menlo, Consolas, monospace; white-space: normal; word-break: break-all; }
.xml-compare-hover-table tr:hover td, .xml-compare-hover-table tr:hover th { background: rgba(96,165,250,.08); }
.xml-compare-hover-empty { display: block; padding: 8px 10px; color: #94a3b8; font-size: 11px; }
.xml-compare-sideload-backdrop { position: fixed; inset: 0; z-index: 50; display: grid; place-items: center; padding: 24px; background: rgba(2, 6, 23, 0.74); }
.xml-compare-sideload-dialog { width: min(1120px, 96vw); max-height: 92vh; display: flex; flex-direction: column; overflow: hidden; border: 1px solid rgba(96, 165, 250, 0.28); border-radius: 16px; background: #0f172a; box-shadow: 0 24px 70px rgba(0, 0, 0, 0.42); }
.xml-compare-sideload-dialog header,
.xml-compare-sideload-dialog footer { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; padding: 14px 16px; border-bottom: 1px solid rgba(148, 163, 184, 0.16); }
.xml-compare-sideload-dialog footer { border-top: 1px solid rgba(148, 163, 184, 0.16); border-bottom: 0; }
.xml-compare-sideload-dialog h3 { margin: 0 0 4px; color: #dbeafe; font-size: 18px; }
.xml-compare-sideload-dialog p { margin: 0; color: #94a3b8; font-size: 12px; }
.xml-compare-sideload-dialog button { padding: 7px 10px; border: 1px solid rgba(96, 165, 250, 0.32); border-radius: 8px; background: #1e293b; color: #dbeafe; cursor: pointer; }
.xml-compare-sideload-target { padding: 12px 16px; border-bottom: 1px solid rgba(148, 163, 184, 0.12); }
.xml-compare-sideload-target label { display: flex; align-items: center; gap: 10px; color: #bfdbfe; font-size: 12px; font-weight: 700; }
.xml-compare-sideload-target select { padding: 6px 9px; border: 1px solid rgba(96, 165, 250, 0.28); border-radius: 8px; background: #0b1220; color: #dbeafe; }
.xml-compare-sideload-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; padding: 14px 16px; overflow: auto; }
.xml-compare-sideload-grid label { display: flex; flex-direction: column; gap: 8px; color: #bfdbfe; font-size: 12px; font-weight: 800; }
.xml-compare-sideload-grid textarea { min-height: 220px; resize: vertical; padding: 10px; border: 1px solid rgba(96, 165, 250, 0.24); border-radius: 10px; background: #020617; color: #dbeafe; font: 12px/1.45 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
.xml-compare-sideload-report { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; margin: 0; flex: 1; }
.xml-compare-sideload-report div { padding: 7px 9px; border: 1px solid rgba(148, 163, 184, 0.14); border-radius: 9px; background: rgba(2, 6, 23, 0.36); }
.xml-compare-sideload-report dt { color: #93c5fd; font-size: 10px; text-transform: uppercase; }
.xml-compare-sideload-report dd { margin: 2px 0 0; color: #e2e8f0; font-size: 12px; }
.xml-compare-sideload-empty { color: #94a3b8; font-size: 12px; }
.xml-compare-sideload-actions { display: flex; flex-wrap: wrap; gap: 8px; justify-content: flex-end; }
@media (max-width: 1280px) { .xml-compare-layout, .xml-compare-workspace-grid, .xml-compare-bottom-tabs, .xml-compare-sideload-grid { grid-template-columns: 1fr; } }
.enr-rtc-table { width: 100%; border-collapse: collapse; font-size: 12px; margin-bottom: 10px; }
.enr-rtc-table th { padding: 6px 8px; text-align: left; color: #93c5fd; font-size: 11px; text-transform: uppercase; letter-spacing: 0.03em; border-bottom: 1px solid rgba(148,163,184,0.18); }
.enr-rtc-table td { padding: 4px 6px; border-bottom: 1px solid rgba(148,163,184,0.1); vertical-align: middle; }
.enr-rtc-table td.enr-rtc-arrow { text-align: center; color: #60a5fa; font-size: 14px; padding: 0 8px; }
.enr-rtc-label { width: 80px; padding: 5px 8px; border: 1px solid rgba(96,165,250,0.22); border-radius: 6px; background: #0b1220; color: #dbeafe; font-size: 12px; }
.enr-rtc-num { width: 70px; padding: 5px 8px; border: 1px solid rgba(96,165,250,0.22); border-radius: 6px; background: #0b1220; color: #dbeafe; font-size: 12px; }
.enr-rtc-del { padding: 3px 7px; border: 1px solid rgba(239,68,68,0.4); border-radius: 6px; background: rgba(239,68,68,0.12); color: #fca5a5; cursor: pointer; font-size: 11px; }
.enr-rtc-del:hover { background: rgba(239,68,68,0.28); }
.enr-rtc-add { margin-top: 4px; padding: 6px 12px; border: 1px dashed rgba(96,165,250,0.4); border-radius: 8px; background: transparent; color: #60a5fa; cursor: pointer; font-size: 12px; }
.enr-rtc-add:hover { background: rgba(96,165,250,0.08); }

/* Enrichment Config popup */
.enr-backdrop { position: fixed; inset: 0; z-index: 60; display: grid; place-items: center; padding: 24px; background: rgba(2, 6, 23, 0.78); }
.enr-dialog { width: min(820px, 96vw); max-height: 92vh; display: flex; flex-direction: column; overflow: hidden; border: 1px solid rgba(96, 165, 250, 0.32); border-radius: 16px; background: #0f172a; box-shadow: 0 24px 72px rgba(0, 0, 0, 0.48); }
.enr-dialog-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; padding: 14px 16px; border-bottom: 1px solid rgba(148, 163, 184, 0.16); flex-shrink: 0; }
.enr-dialog-header h3 { margin: 0 0 4px; color: #dbeafe; font-size: 18px; }
.enr-dialog-header p { margin: 0; color: #94a3b8; font-size: 12px; }
.enr-dialog-header button { padding: 7px 10px; border: 1px solid rgba(96, 165, 250, 0.32); border-radius: 8px; background: #1e293b; color: #dbeafe; cursor: pointer; flex-shrink: 0; }
/* Tab bar */
.enr-tab-bar { display: flex; gap: 2px; padding: 8px 14px 0; background: rgba(2, 6, 23, 0.44); border-bottom: 1px solid rgba(148, 163, 184, 0.16); flex-shrink: 0; }
.enr-tab-btn { display: flex; align-items: center; gap: 7px; padding: 7px 14px 9px; border: 1px solid transparent; border-bottom: none; border-radius: 10px 10px 0 0; background: transparent; color: #64748b; font-size: 12px; font-weight: 600; cursor: pointer; transition: color 0.15s, background 0.15s; white-space: nowrap; }
.enr-tab-btn:hover { color: #93c5fd; background: rgba(96, 165, 250, 0.06); }
.enr-tab-btn.is-active { color: #dbeafe; background: #0f172a; border-color: rgba(148, 163, 184, 0.18); margin-bottom: -1px; padding-bottom: 10px; }
.enr-tab-dot { width: 7px; height: 7px; border-radius: 50%; background: rgba(148, 163, 184, 0.28); flex-shrink: 0; }
.enr-tab-dot.is-on { background: #22c55e; box-shadow: 0 0 5px rgba(34, 197, 94, 0.5); }
/* Dialog body */
.enr-dialog-body { flex: 1; overflow-y: auto; padding: 14px 16px; display: flex; flex-direction: column; gap: 10px; }
.enr-dialog-footer { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 12px 16px; border-top: 1px solid rgba(148, 163, 184, 0.16); flex-shrink: 0; }
.enr-footer-note { margin: 0; color: #64748b; font-size: 11px; }
.enr-footer-actions { display: flex; gap: 8px; }
.enr-footer-actions button { padding: 7px 12px; border: 1px solid rgba(96, 165, 250, 0.32); border-radius: 8px; background: #1e293b; color: #dbeafe; font-size: 12px; cursor: pointer; }
.enr-btn-primary { background: #1d4ed8 !important; border-color: rgba(147, 197, 253, 0.5) !important; }
.enr-btn-primary:hover { background: #2563eb !important; }
/* Sections inside tab panels */
.enr-section { border: 1px solid rgba(148, 163, 184, 0.14); border-radius: 12px; overflow: hidden; background: rgba(15, 23, 42, 0.6); }
.enr-section-toggle { display: flex; align-items: center; gap: 9px; padding: 10px 12px; cursor: pointer; color: #bfdbfe; font-size: 12px; font-weight: 700; background: rgba(2, 6, 23, 0.28); border-bottom: 1px solid rgba(148, 163, 184, 0.1); }
.enr-section-toggle input[type="checkbox"] { width: 15px; height: 15px; accent-color: #3b82f6; flex-shrink: 0; }
.enr-section-content { padding: 12px; display: flex; flex-direction: column; gap: 10px; }
.enr-section.is-disabled .enr-section-content { opacity: 0.42; pointer-events: none; }
.enr-row { display: flex; flex-wrap: wrap; gap: 10px; }
.enr-row-3 { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
.enr-field { display: flex; flex-direction: column; gap: 5px; flex: 1; min-width: 100px; }
.enr-field span { color: #93c5fd; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; }
.enr-field input, .enr-field select { padding: 7px 9px; border: 1px solid rgba(96, 165, 250, 0.24); border-radius: 8px; background: #020617; color: #dbeafe; font-size: 12px; min-width: 0; }
.enr-field select { cursor: pointer; }
.enr-textarea-label { display: flex; flex-direction: column; gap: 5px; }
.enr-textarea-label span { color: #93c5fd; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; }
.enr-textarea-label textarea { min-height: 120px; resize: vertical; padding: 9px; border: 1px solid rgba(96, 165, 250, 0.24); border-radius: 10px; background: #020617; color: #dbeafe; font: 12px/1.45 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
.enr-radio-group { display: flex; gap: 16px; padding: 2px 0; }
.enr-radio-group label { display: flex; align-items: center; gap: 6px; color: #cbd5e1; font-size: 12px; cursor: pointer; }
.enr-radio-group input[type="radio"] { accent-color: #3b82f6; }
.enr-comp-grid { display: grid; grid-template-columns: max-content max-content minmax(0, 160px); align-items: center; gap: 8px 10px; }
.enr-comp-grid code { color: #93c5fd; font-size: 12px; background: rgba(96, 165, 250, 0.1); padding: 2px 6px; border-radius: 5px; }
.enr-default-label { color: #94a3b8; font-size: 12px; }
.enr-arrow { color: #475569; font-size: 14px; text-align: center; }
.enr-hint { margin: 0; color: #64748b; font-size: 11px; line-height: 1.5; }

/* Step 8: manual anchor + candidate review + compare panel */
.xmlc-anchor-review { display: grid; gap: 10px; }
.xmlc-anchor-rail { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; padding: 10px 12px; border: 1px solid rgba(125,211,252,.30); border-radius: 12px; background: rgba(8,47,73,.32); }
.xmlc-anchor-cell { display: grid; gap: 2px; }
.xmlc-anchor-cell b { color: #bfdbfe; font-size: 11px; text-transform: uppercase; letter-spacing: .04em; }
.xmlc-anchor-cell span { color: #e0f2fe; font-size: 13px; font-family: ui-monospace, Menlo, Consolas, monospace; }
.xmlc-anchor-actions { display: flex; gap: 8px; margin-left: auto; }
.xmlc-anchor-actions button { border: 1px solid rgba(125,211,252,.35); border-radius: 9px; background: rgba(14,116,144,.5); color: #e0f2fe; padding: 7px 12px; font-weight: 800; cursor: pointer; }
.xmlc-anchor-actions button:disabled { opacity: .45; cursor: default; }
.xmlc-subtitle { color: #93c5fd; font-weight: 800; font-size: 12px; margin-top: 4px; }
.xmlc-empty { color: #94a3b8; font-size: 12px; padding: 10px; border: 1px dashed rgba(148,163,184,.3); border-radius: 10px; }
.xmlc-cand-summary { color: #cbd5e1; font-size: 12px; font-weight: 700; }
.xmlc-table-scroll { overflow: auto; max-height: 320px; border: 1px solid rgba(148,163,184,.18); border-radius: 10px; }
.xmlc-table { width: 100%; border-collapse: collapse; font-size: 12px; }
.xmlc-table th, .xmlc-table td { border-bottom: 1px solid rgba(148,163,184,.13); padding: 6px 8px; text-align: left; vertical-align: top; }
.xmlc-table th { color: #93c5fd; position: sticky; top: 0; background: #0f172a; }
.xmlc-cand.is-conflict { background: rgba(127,29,29,.22); }
.xmlc-cand.is-review { background: rgba(113,63,18,.16); }
.xmlc-cand-actions { display: flex; gap: 6px; }
.xmlc-cand-actions button { border: 1px solid rgba(125,211,252,.3); border-radius: 8px; padding: 4px 9px; font-weight: 800; cursor: pointer; }
.xmlc-approve { background: rgba(6,78,59,.5); color: #bbf7d0; }
.xmlc-reject { background: rgba(76,29,29,.5); color: #fecaca; }
.xmlc-anchor-tag { color: #7dd3fc; font-size: 11px; font-weight: 800; }
.xmlc-chip { display: inline-block; padding: 1px 8px; border-radius: 999px; font-size: 10px; font-weight: 850; letter-spacing: .03em; }
.xmlc-chip.is-valid, .xmlc-chip.is-unchanged { background: rgba(6,78,59,.55); color: #bbf7d0; }
.xmlc-chip.is-within-tol { background: rgba(30,58,138,.55); color: #bfdbfe; }
.xmlc-chip.is-review { background: rgba(113,63,18,.55); color: #fde68a; }
.xmlc-chip.is-conflict, .xmlc-chip.is-changed, .xmlc-chip.is-missing { background: rgba(127,29,29,.55); color: #fecaca; }
.xmlc-chip.is-no-target, .xmlc-chip.is-blank { background: rgba(51,65,85,.6); color: #cbd5e1; }

/* Step 8 layout: validation candidates (left) + transfer/compare (right) */
.xmlc-workspace-columns { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: 12px; margin-top: 12px; align-items: start; }
.xmlc-candidate-review-stack { display: grid; gap: 12px; padding: 12px; }
.xmlc-col { min-width: 0; }
.xmlc-col-left .xml-compare-compare-field-controls { display: block; }
.xmlc-col .xml-compare-manual-validation-builder { width: 100%; display: flex; flex-direction: column; gap: 8px; }
.xmlc-col .xml-compare-topology-table { width: 100%; }
.xml-compare-validation-card { border: 1px solid rgba(148,163,184,.18); border-radius: 12px; background: rgba(2,6,23,.34); padding: 16px; }
.xml-compare-validation-card h4 { margin: 0 0 12px 0; color: #e0f2fe; }
.xml-compare-validation-scroll { max-height: 400px; overflow-y: auto; border: 1px solid rgba(148,163,184,.18); border-radius: 8px; background: #020617; }
.xml-compare-validation-tabs { display: flex; gap: 4px; margin-bottom: 12px; background: rgba(15,23,42,0.4); padding: 4px; border-radius: 8px; border: 1px solid rgba(148,163,184,.15); }
.xml-compare-validation-tab { flex: 1; padding: 8px 12px; background: transparent; border: none; border-radius: 6px; color: #94a3b8; font-weight: 800; cursor: pointer; text-align: center; }
.xml-compare-validation-tab:hover { background: rgba(30,41,59,.6); color: #e2e8f0; }
.xml-compare-validation-tab.is-active { background: rgba(14,116,144,.62); color: #e0f2fe; }
.xml-compare-checkbox-label { display: flex; align-items: center; gap: 8px; color: #bfdbfe; font-weight: 800; font-size: 13px; margin-top: 8px; }
.xml-compare-validation-action-btn { margin-top: 12px; width: 100%; padding: 10px; font-size: 14px; background: rgba(3,105,161,.6); color: #f0f9ff; border: 1px solid rgba(56,189,248,.4); border-radius: 8px; font-weight: 800; cursor: pointer; }
.xml-compare-validation-action-btn:hover { background: rgba(3,105,161,.8); }
.xml-compare-validation-bulk-actions { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 12px; padding: 12px; background: rgba(14,116,144,.1); border: 1px solid rgba(14,116,144,.3); border-radius: 8px; }
.xml-compare-validation-bulk-actions label { flex: 1; color: #bae6fd; font-weight: 800; font-size: 14px; display: flex; align-items: center; gap: 8px; margin: 0; }
.xml-compare-validation-bulk-actions .xml-compare-validation-action-btn { width: auto; margin-top: 0; padding: 6px 12px; background: rgba(14,116,144,.6); border-color: rgba(6,182,212,.4); }
.xml-compare-validation-bulk-actions .xml-compare-validation-action-btn:hover { background: rgba(14,116,144,.8); }
.table-categorized-inline-details { margin-top: 12px; background: rgba(30,41,59,.6); border: 1px solid rgba(148,163,184,.2); border-radius: 6px; padding: 8px; }
.table-categorized-inline-details summary { cursor: pointer; font-size: 13px; font-weight: 600; color: #bae6fd; user-select: none; }
.table-categorized-inline-details-content { margin-top: 12px; display: flex; flex-direction: column; gap: 8px; }
@media (max-width: 1024px) { .xmlc-workspace-columns { grid-template-columns: 1fr; } }
.xml-compare-transfer-apply-actions { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 12px; margin-bottom: 12px; }
.xml-compare-transfer-apply-actions button { border: 1px solid rgba(16, 185, 129, 0.4); border-radius: 6px; padding: 6px 12px; background: rgba(6, 78, 59, 0.4); color: #d1fae5; font-weight: 600; cursor: pointer; }
.xml-compare-transfer-apply-actions button:hover { background: rgba(6, 78, 59, 0.7); }
.xml-compare-transfer-apply-actions button:disabled { opacity: 0.5; cursor: not-allowed; }

/* AIM config: match basis + transfer blocks */
.xmlc-aim-config { display: grid; gap: 8px; padding: 10px 12px; margin: 8px 0; border: 1px solid rgba(125,211,252,.28); border-radius: 10px; background: rgba(8,47,73,.28); }
.xmlc-aim-row { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
.xmlc-aim-row > b { color: #bfdbfe; font-size: 11px; text-transform: uppercase; letter-spacing: .04em; min-width: 92px; }
.xmlc-aim-row select, .xmlc-aim-row input { border: 1px solid rgba(96,165,250,.3); border-radius: 8px; background: #020617; color: #dbeafe; padding: 5px 8px; }
.xmlc-aim-row label { color: #cbd5e1; font-size: 12px; display: inline-flex; gap: 5px; align-items: center; }
.xmlc-mode-pill, .xmlc-field-name { display: inline-flex; align-items: center; min-height: 28px; padding: 4px 9px; border: 1px solid rgba(125,211,252,.24); border-radius: 8px; background: rgba(2,6,23,.45); color: #dbeafe; font-size: 12px; }
.xmlc-field-name { font-family: ui-monospace, Menlo, Consolas, monospace; color: #93c5fd; }
.xmlc-block-checks { display: flex; flex-wrap: wrap; gap: 4px 14px; }
.xmlc-block-chk { color: #dbeafe; font-size: 12px; display: inline-flex; gap: 5px; align-items: center; }
.xmlc-block-source { color: #93c5fd; font-size: 11px; }

/* Hierarchical connectors */
.xmlc-conn-list { display: flex; flex-wrap: wrap; gap: 6px 14px; }
.xmlc-conn { color: #dbeafe; font-size: 12px; display: inline-flex; gap: 6px; align-items: center; border: 1px solid rgba(125,211,252,.22); border-radius: 8px; padding: 3px 8px; background: rgba(8,47,73,.35); }
.xmlc-conn b { color: #bfdbfe; }
.xmlc-conn-map { color: #93c5fd; font-family: ui-monospace, Menlo, Consolas, monospace; font-size: 11px; }
.xmlc-valid-rule { color: #bae6fd; font-weight: 800; font-size: 13px; }
.xmlc-muted { color: #64748b; }
.xmlc-delta { font-family: ui-monospace, Menlo, Consolas, monospace; font-weight: 800; }
.xmlc-delta.is-valid { color: #bbf7d0; }
.xmlc-delta.is-review { color: #fde68a; }
.xmlc-cand.is-approval-approved td { background: rgba(6, 78, 59, .18); }
.xmlc-cand.is-approval-rejected td, .xmlc-cand.is-approval-blocked td { background: rgba(127, 29, 29, .16); }
.xmlc-approval { display: inline-flex; align-items: center; justify-content: center; min-width: 76px; padding: 3px 8px; border-radius: 999px; font-size: 11px; font-weight: 900; letter-spacing: .03em; }
.xmlc-approval.is-approved { background: rgba(6, 95, 70, .9); color: #d1fae5; }
.xmlc-approval.is-pending { background: rgba(51, 65, 85, .9); color: #dbeafe; }
.xmlc-approval.is-rejected, .xmlc-approval.is-blocked { background: rgba(127, 29, 29, .9); color: #fee2e2; }
.xmlc-approval.is-anchor { background: rgba(30, 64, 175, .9); color: #dbeafe; }
.xmlc-approved-note, .xmlc-rejected-note { color: #bbf7d0; font-weight: 800; font-size: 12px; }
.xmlc-rejected-note { color: #fecaca; }
.xmlc-approval-counts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
.xmlc-approval-counts div { border: 1px solid rgba(96,165,250,.2); border-radius: 8px; padding: 8px; background: rgba(2,6,23,.35); }
.xmlc-approval-counts b { display: block; color: #93c5fd; font-size: 11px; text-transform: uppercase; }
.xmlc-approval-counts span { display: block; margin-top: 3px; color: #e2e8f0; font-size: 18px; font-weight: 900; }
.xmlc-transfer-review { display: grid; gap: 14px; padding: 16px; overflow: auto; max-height: calc(100vh - 170px); }
.xmlc-transfer-card { margin: 0; min-width: 0; }
.xmlc-transfer-card > summary { cursor: pointer; color: #bfdbfe; font-weight: 900; padding: 12px 14px; text-transform: uppercase; letter-spacing: .03em; }
.xmlc-transfer-metrics { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; }
.xmlc-transfer-metric { border: 1px solid rgba(96,165,250,.2); border-radius: 8px; padding: 10px; background: rgba(2,6,23,.35); min-width: 0; }
.xmlc-transfer-metric b { display: block; color: #93c5fd; font-size: 11px; text-transform: uppercase; }
.xmlc-transfer-metric span { display: block; margin-top: 4px; color: #e2e8f0; font-size: 14px; font-weight: 800; overflow-wrap: anywhere; }
.xmlc-transfer-output { border-color: rgba(14,165,233,.36); background: rgba(8,47,73,.38); }
.xmlc-transfer-output-body { display: grid; grid-template-columns: minmax(220px, 300px) minmax(0, 1fr); gap: 12px; align-items: center; padding: 12px; }
.xmlc-transfer-output-state { min-width: 0; display: grid; gap: 4px; }
.xmlc-transfer-output-state b { color: #bae6fd; font-size: 16px; }
.xmlc-transfer-output-state span { color: #93c5fd; font-family: ui-monospace, Menlo, Consolas, monospace; font-size: 12px; overflow-wrap: anywhere; }
.xmlc-transfer-output-actions { justify-content: flex-end; margin: 0; }
.xmlc-transfer-output-actions button.is-primary { background: rgba(14,116,144,.72); border-color: rgba(34,211,238,.55); color: #ecfeff; font-weight: 900; }
.xmlc-transfer-review .xml-compare-automap-panel { min-width: 0; margin: 12px; border: 1px solid rgba(96,165,250,.18); border-radius: 10px; background: rgba(2,6,23,.30); overflow: hidden; }
.xmlc-transfer-review .xml-compare-automap-panel + .xml-compare-automap-panel { margin-top: 0; }
.xmlc-transfer-review .xml-compare-automap-panel header { display: flex; justify-content: space-between; gap: 10px; padding: 10px 12px; border-bottom: 1px solid rgba(148,163,184,.14); }
.xmlc-transfer-review .xml-compare-automap-panel header b { color: #dbeafe; }
.xmlc-transfer-review .xml-compare-automap-panel header span { color: #94a3b8; font-size: 11px; }
.xmlc-transfer-review .xml-compare-validation-summary { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; padding: 10px 12px; }
.xmlc-transfer-review .xml-compare-validation-summary span { min-width: 0; border: 1px solid rgba(148,163,184,.14); border-radius: 8px; padding: 8px; background: rgba(15,23,42,.55); color: #dbeafe; overflow-wrap: anywhere; }
.xmlc-transfer-review .xml-compare-validation-summary b { color: #93c5fd; font-size: 10px; text-transform: uppercase; }
.xml-compare-transfer-workflow-list { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 8px; padding: 0 12px 10px; }
.xml-compare-workflow-step { border: 1px solid rgba(148,163,184,.14); border-radius: 8px; padding: 8px; background: rgba(15,23,42,.45); }
.xml-compare-workflow-step header { padding: 0; border: 0; }
.xml-compare-workflow-step p { margin: 6px 0 0; color: #cbd5e1; font-size: 12px; line-height: 1.35; }
.xml-compare-workflow-step.is-ready, .xml-compare-workflow-step.is-complete { border-color: rgba(16,185,129,.32); }
.xml-compare-workflow-step.is-blocked { border-color: rgba(248,113,113,.34); }
.xml-compare-warning { margin: 0 12px 12px; border: 1px solid rgba(251,191,36,.30); border-radius: 8px; padding: 8px 10px; color: #fde68a; font-size: 12px; }
.xmlc-transfer-review .xml-compare-bottom-panel { border: 0; border-radius: 0; background: transparent; }
.xmlc-transfer-review .xml-compare-bottom-panel > header { display: none; }
.xmlc-transfer-review .xml-compare-detail-card { grid-template-columns: repeat(4, minmax(0, 1fr)); }
.xmlc-transfer-review .xml-compare-table-scroll { max-height: 280px; overflow: auto; }
.xml-compare-transfer-review-list { display: grid; gap: 10px; padding: 0 12px 12px; }
.xml-compare-transfer-review-row { border: 1px solid rgba(148,163,184,.14); border-radius: 8px; background: rgba(15,23,42,.42); overflow: hidden; }
.xml-compare-transfer-review-row header { padding: 8px 10px; }
.xml-compare-transfer-review-row small { display: block; padding: 0 10px 8px; color: #94a3b8; }
.xml-compare-transfer-review-snippets { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; padding: 0 10px 10px; }
.xml-compare-transfer-review-snippets pre { min-width: 0; max-height: 160px; overflow: auto; margin: 0; padding: 8px; border: 1px solid rgba(148,163,184,.12); border-radius: 8px; background: #020617; color: #dbeafe; font-size: 11px; white-space: pre-wrap; }
@media (max-width: 900px) { .xmlc-transfer-metrics, .xmlc-transfer-review .xml-compare-validation-summary, .xmlc-transfer-review .xml-compare-detail-card, .xml-compare-transfer-review-snippets { grid-template-columns: repeat(2, minmax(0, 1fr)); } .xmlc-transfer-output-body { grid-template-columns: 1fr; } .xmlc-transfer-output-actions { justify-content: flex-start; } }
