import { buildFieldCatalog } from './table-categorized-field-catalog.js';
import { createBuildLedger } from './table-categorized-xml-build-ledger.js';
import { PIVOT_AGGREGATES } from './table-categorized-pivot-spec-contracts.js';
import { buildPivotViewModel } from './table-categorized-pivot-view-model.js';
import { exportPivotViewModelHtmlPreview } from './table-categorized-pivot-exporters.js';
import { PS_MAPPING_TABLE_2_SHADOW_PROFILE } from './table-categorized-xml-pilot-profiles.js';
import { activeSource, DELIMITER_MODE_OPTIONS } from './table-categorized-xml-source-manager.js';
import { CREATION_MODE_OPTIONS, LEVEL_TYPE_OPTIONS, generateSuggestedProfiles } from './table-categorized-xml-profile-designer.js';
import { previewSourceTransform } from './table-categorized-xml-source-transforms.js';

export const TABLE_CATEGORIZED_XML_SHELL_SCHEMA = 'table-categorized-xml-shell/v35-field-comparison-sample';
export const TABLE_CATEGORIZED_XML_BUTTON_ATTR = 'data-xml-compare-table-categorized-open';
export const TABLE_CATEGORIZED_XML_POPUP_ATTR = 'data-xml-compare-table-categorized-popup';
export const TABLE_CATEGORIZED_STEPS = Object.freeze(['table', 'columns', 'structure', 'preview', 'export']);
export const TABLE_CATEGORIZED_STEP_LABELS = Object.freeze({ table: 'Table', columns: 'Columns', structure: 'Structure', preview: 'Preview', export: 'Export' });
export const TABLE_CATEGORIZED_XML_TABS = Object.freeze([['source', '1 Table', 'Import'], ['levels', '2 Columns', 'Map'], ['graph', '3 Structure', 'Build'], ['validation', '4 Preview', 'Check'], ['export', '5 Export', 'Files']]);
export const TABLE_CATEGORIZED_SETUP_TABS = Object.freeze([]);
export const PIVOT_FILTER_OPERATORS = Object.freeze(['equals', 'notEquals', 'contains', 'notContains', 'blank', 'notBlank']);

const esc = (value) => String(value ?? '').replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;').replaceAll('"', '&quot;').replaceAll("'", '&#039;');
const sourcesFor = (state = {}) => state.sources?.length ? state.sources : [state.source].filter(Boolean);
const activeFor = (state = {}) => activeSource({ sources: sourcesFor(state), activeSourceId: state.activeSourceId }) || sourcesFor(state)[0] || {};
const hasRows = (state = {}) => sourcesFor(state).some((source) => source?.rows?.length);
const blockers = (state = {}) => (state.validationResults || []).filter((item) => ['BLOCKER', 'ERROR'].includes(item?.severity));
const stepFromTab = (tab) => ({ source: 'table', levels: 'columns', graph: 'structure', validation: 'preview', export: 'export' }[tab] || 'table');
const tabFromStep = (step) => ({ table: 'source', columns: 'levels', structure: 'graph', preview: 'validation', export: 'export' }[step] || 'source');

export function setupTabForWorkflowTab(activeTab) { return ({ source: 'source', levels: 'fields', graph: 'structure', validation: 'quality', export: 'output' }[activeTab] || 'source'); }
export function isSetupTabEnabledForWorkflow() { return false; }
export function levelPathKey(path = []) { return path.join('.'); }
export function levelChildCount(level = {}) { return Array.isArray(level.children) ? level.children.length : 0; }
export function flattenLevelDefinitions(levels = [], path = []) { return levels.flatMap((level, index) => [{ level, path: [...path, index] }, ...flattenLevelDefinitions(level.children || [], [...path, index])]); }
export function statusBadge(status, label = status) { return `<span class="table-categorized-status is-${esc(status)}" data-table-categorized-status="${esc(status)}" aria-label="${esc(label)}">${esc(statusIcon(status))}</span>`; }
export function renderDisclosure({ id, title, summary = '', body = '', open = false, tone = 'secondary' } = {}) { return `<details class="table-categorized-disclosure is-${esc(tone)}" data-table-categorized-disclosure="${esc(id)}" ${open ? 'open' : ''}><summary>${esc(title)}${summary ? `<small>${esc(summary)}</small>` : ''}</summary>${body}</details>`; }
export function createTableCategorizedStepStatus(state = {}) { const rows = hasRows(state), blocked = blockers(state).length > 0, fieldIssue = state.profileValidation?.some((d) => ['BLOCKER', 'ERROR'].includes(d?.severity)), columns = rows ? (state.columnsConfirmed ? (fieldIssue ? 'warning' : 'complete') : 'ready') : 'locked'; return { table: rows ? 'complete' : 'ready', columns, structure: rows && state.columnsConfirmed ? (state.graph ? 'complete' : 'ready') : 'locked', preview: state.graph ? (blocked ? 'error' : 'complete') : 'locked', export: state.exportResult?.ok ? 'complete' : 'locked' }; }
export function renderTableCategorizedXmlButtonHtml() { return `<button type="button" class="xml-compare-table-categorized-btn" ${TABLE_CATEGORIZED_XML_BUTTON_ATTR}>Table to Categorized XML</button>`; }
export function renderTableCategorizedXmlShellHtml(state = {}) { const view = { activeStep: stepFromTab(state.activeTab), activeTab: 'source', sources: [], activeSourceId: 'S1', profile: PS_MAPPING_TABLE_2_SHADOW_PROFILE, compareCanvas: {}, ...state }; view.activeStep = TABLE_CATEGORIZED_STEPS.includes(view.activeStep) ? view.activeStep : 'table'; const full = Boolean(view.isFullscreen || view.fullscreen); return `<div class="table-categorized-xml-backdrop" ${TABLE_CATEGORIZED_XML_POPUP_ATTR} data-table-categorized-fullscreen="${full ? 'true' : 'false'}">${renderShellLocalStyles()}<section class="table-categorized-xml-dialog ${full ? 'is-fullscreen' : ''}" role="dialog" aria-modal="true" aria-label="Table to Categorized XML"><header><div><h3>Table to Categorized XML</h3><p>Load table → confirm columns → build structure → preview result → download XML.</p></div><div class="table-categorized-xml-actions"><label class="table-categorized-fullscreen-toggle" title="Fullscreen" aria-label="Fullscreen"><input type="checkbox" data-table-categorized-fullscreen-icon><span aria-hidden="true">⛶</span></label><button type="button" data-table-categorized-close>Close</button></div></header>${renderStepStrip(view)}<main class="table-categorized-xml-body">${renderStepBody(view)}</main></section></div>`; }
export function renderTabStrip(activeTab = 'source', view = {}) { return renderStepStrip({ ...view, activeStep: stepFromTab(activeTab) }); }
export function renderSetupTabStrip() { return ''; }
export function renderTabBody(view = {}) { return renderStepBody({ ...view, activeStep: stepFromTab(view.activeTab) }); }
export function renderSourceSetup(view = {}) { return renderTableStep(view); }
export function renderLevelDesigner(view = {}) { return renderColumnsStep(view); }
function renderShellLocalStyles() { return '<style data-table-categorized-local-style>.table-categorized-xml-dialog:has([data-table-categorized-fullscreen-icon]:checked){width:100vw!important;height:100vh!important;max-width:none!important;max-height:none!important;border-radius:0!important}.table-categorized-fullscreen-toggle{display:inline-flex;align-items:center;justify-content:center;min-width:34px;min-height:34px;cursor:pointer}.table-categorized-fullscreen-toggle input{position:absolute;opacity:0;pointer-events:none}.table-categorized-structure-workspace.is-scrollable{max-height:58vh;overflow-y:auto;padding-right:6px;scrollbar-gutter:stable}.table-categorized-live-preview{max-height:42vh;overflow:auto}</style>'; }
function statusIcon(status) { return { complete: '✓', ready: '●', warning: '⚠', error: '✕', locked: '○' }[status] || '●'; }
function renderStepStrip(view) { const status = createTableCategorizedStepStatus(view); return `<nav class="table-categorized-stepper" aria-label="Table categorizer steps">${TABLE_CATEGORIZED_STEPS.map((step, index) => renderStepButton(step, index, view, status)).join('')}</nav>`; }
function renderStepButton(step, index, view, status) { const locked = status[step] === 'locked', active = view.activeStep === step; return `<button type="button" data-table-categorized-step="${step}" data-table-categorized-tab="${tabFromStep(step)}" data-step-status="${status[step]}" class="${active ? 'is-active' : ''} is-status-${status[step]}" ${locked ? 'disabled aria-disabled="true"' : 'aria-disabled="false"'}><b>${index + 1} ${TABLE_CATEGORIZED_STEP_LABELS[step]} ${statusBadge(status[step])}</b><small>${stepSubtitle(step, status[step])}</small></button>`; }
function renderStepBody(view) { if (view.activeStep === 'columns') return renderColumnsStep(view); if (view.activeStep === 'structure') return renderStructureStep(view); if (view.activeStep === 'preview') return renderPreviewStep(view); if (view.activeStep === 'export') return renderExportStep(view); return renderTableStep(view); }
function stepSubtitle(step, status) { if (status === 'locked') return 'Locked'; if (step === 'columns' && status === 'complete') return 'Fields confirmed'; if (step === 'columns' && status === 'warning') return 'Review field issues'; return { table: 'Add source', columns: 'Confirm fields', structure: 'Build structure', preview: 'Check result', export: 'Download files' }[step]; }
function renderTableStep(view) { const active = activeFor(view), sources = sourcesFor(view); return `<div class="table-categorized-shell-toolbar"><label>Table ID<select data-table-categorized-active-source>${sources.map((s) => `<option ${s.sourceId === active.sourceId ? 'selected' : ''}>${esc(s.sourceId)}</option>`).join('')}</select></label><label>Table Name<input data-table-categorized-source-name value="${esc(active.sourceName || '')}"></label><div class="table-categorized-shell-toolbar-actions"><button type="button" data-table-categorized-action="add-source">+ Add</button><button type="button" data-table-categorized-action="remove-source">- Remove</button><button type="button" data-table-categorized-action="clear">↺ Clear</button></div></div><div class="table-categorized-shell-split"><div class="table-categorized-shell-main"><div class="table-categorized-drop-zone"><span>📥 Drag & Drop CSV / TXT File Here</span></div><div class="table-categorized-divider"><span>- OR -</span></div><label class="table-categorized-shell-paste"><span>Paste Table Text (Headers required):</span><textarea data-table-categorized-source-text>${esc(active.sourceText || '')}</textarea></label></div><div class="table-categorized-shell-side"><div class="table-categorized-shell-side-card"><h4>Advanced Settings</h4>${renderDelimiterSelect(active)}<hr/><h4>Load Template</h4><button type="button" data-table-categorized-action="load-sample">Load Sample</button><button type="button" data-table-categorized-action="load-coordinate-sample">Load Coordinate Sample</button><button type="button" data-table-categorized-action="load-two-source-template">Load Two-source Template</button><button type="button" data-table-categorized-action="load-field-comparison-sample">Load Field Comparison Sample</button><hr/><h4>Upload CSV Manually</h4><label class="table-categorized-file">Choose File...<input type="file" data-table-categorized-file></label></div></div></div><div class="table-categorized-shell-footer"><button type="button" class="is-primary" data-table-categorized-action="parse">Read Table (Parse)</button><div class="table-categorized-shell-status">Status: ${active.rows?.length || 0} Rows Parsed | ${active.diagnostics?.filter((d) => ['ERROR', 'BLOCKER'].includes(d.severity)).length || 0} Errors</div></div>`; }
function renderColumnsStep(view) { const active = activeFor(view); return `<div class="table-categorized-shell-toolbar"><label>Format ID<input data-profile-field="profileId" value="${esc(view.profile?.profileId || '')}"></label><label>Format Name<input data-profile-field="displayName" value="${esc(view.profile?.displayName || '')}"></label></div><div class="table-categorized-shell-split"><div class="table-categorized-shell-main"><div class="table-categorized-shell-side-card"><h4>Column Catalog <small>Detected Columns (Visual Grid)</small></h4>${renderColumnCatalog(active)}</div>${renderColumnCustomization(active)}</div><div class="table-categorized-shell-side"><div class="table-categorized-shell-side-card"><h4>Raw Data Preview (First 8 Rows)</h4><div class="table-categorized-raw-preview">${renderRawPreview(active)}</div></div></div></div><div class="table-categorized-shell-footer"><button type="button" class="is-primary" data-table-categorized-action="confirm-columns" ${active?.rows?.length ? '' : 'disabled'}>Confirm Columns</button><div class="table-categorized-shell-status">Status: ${view.columnsConfirmed ? 'Columns Confirmed. Proceed to Structure.' : 'Review columns and confirm.'}</div></div>`; }
function renderColumnCatalog(source = {}) { const catalog = buildFieldCatalog([source]); if (!catalog.fields.length) return '<p>No fields detected yet. Read a table first.</p>'; return `<table data-table-categorized-field-catalog="FieldCatalog.v1"><thead><tr><th>Field</th><th>Type</th><th>Role</th><th>Unique</th><th>Blank</th><th>Samples</th></tr></thead><tbody>${catalog.fields.map(renderFieldRow).join('')}</tbody></table>`; }
function renderFieldRow(field) { const issues = field.diagnostics?.length ? ` ⚠ ${field.diagnostics.length}` : ''; return `<tr data-field-id="${esc(field.fieldId)}"><td><b>${esc(field.label)}</b><br><small>${esc(field.sourceId)} / ${esc(field.columnId)} / ${esc(field.kind)}${issues}</small></td><td>${esc(field.type)}${field.unit ? ` (${esc(field.unit)})` : ''}</td><td>${esc(field.role)}</td><td>${esc(field.uniqueCount)}</td><td>${esc(field.blankCount)}</td><td>${field.sampleValues.map(esc).join(', ')}</td></tr>`; }
function renderColumnCustomization(source = {}) { const rules = source.transformRules || []; return `<div class="table-categorized-shell-side-card"><h4>Column customization</h4><button type="button" data-table-categorized-action="add-derived-column">+ Add new column</button>${rules.length ? rules.map((rule, index) => renderTransformRule(source, rule, index)).join('') : '<p>Add a derived column before mapping, such as PS_NO_Trimmed or X_clean.</p>'}</div>`; }
function renderTransformRule(source, rule, index) { const preview = previewSourceTransform(source, rule, 6); return `<div class="table-categorized-transform-rule" data-transform-index="${index}"><label>New column name<input data-source-transform-field="newColumn" data-transform-index="${index}" value="${esc(rule.newColumn || '')}"></label><label>Source column<select data-source-transform-field="sourceColumn" data-transform-index="${index}">${(source.headers || []).map((h) => `<option value="${esc(h)}" ${h === rule.sourceColumn ? 'selected' : ''}>${esc(h)}</option>`).join('')}</select></label><label>Operation<select data-source-transform-field="operation" data-transform-index="${index}">${operationOptions(rule.operation)}</select></label><label>Find text / delimiter<input data-source-transform-field="find" data-transform-index="${index}" value="${esc(rule.find || '')}"></label><label>Replace with<input data-source-transform-field="replaceWith" data-transform-index="${index}" value="${esc(rule.replaceWith || '')}"></label><div class="table-categorized-xml-actions"><button type="button" data-table-categorized-action="preview-derived-column" data-transform-index="${index}">Preview</button><button type="button" data-table-categorized-action="remove-derived-column" data-transform-index="${index}">Delete</button></div><h5>Preview result</h5>${renderTransformPreview(preview)}</div>`; }
function operationOptions(value) { return [['copy', 'Copy'], ['trim', 'Trim'], ['take-before', 'Take before'], ['take-after', 'Take after'], ['replace-text', 'Replace text'], ['regex-replace', 'Regex replace']].map(([id, label]) => `<option value="${id}" ${id === value ? 'selected' : ''}>${label}</option>`).join(''); }
function renderTransformPreview(preview) { const rows = preview.rows || []; if (!rows.length) return '<p>No rows to preview.</p>'; return `<table><thead><tr><th>Source value</th><th>New value</th></tr></thead><tbody>${rows.map((r) => `<tr><td>${esc(r.sourceValue)}</td><td>${esc(r.newValue)}</td></tr>`).join('')}</tbody></table>`; }
function renderStructureStep(view) { const active = activeFor(view), catalog = buildFieldCatalog([active]), selectedPath = selectedPathFor(view), selected = levelAtPath(view.profile?.levelDefinitions || [], selectedPath); return `<div class="table-categorized-shell-split"><div class="table-categorized-shell-main"><div class="table-categorized-shell-side-card"><h4>Structure Recipe Builder</h4><p>Pick a tree level, then click a field action: Key, Display, XML Field, or Child Level.</p><div class="table-categorized-structure-workspace is-scrollable" data-table-categorized-structure-scroll="true"><section><h4>FieldCatalog Fields</h4>${renderFieldChoiceList(catalog, selectedPath)}</section><section><h4>Recipe Tree</h4><div class="table-categorized-recipe-tree" data-table-categorized-recipe-tree="true">${renderRecipeTree(view.profile?.levelDefinitions || [], selectedPath)}</div></section></div></div><div class="table-categorized-shell-side-card"><h4>Suggested Structures</h4>${renderSuggestedStructures(view)}</div></div><div class="table-categorized-shell-side">${renderSelectedNodePanel(selected, selectedPath, catalog)}${renderStructureLivePreview(active, selected, selectedPath, catalog)}</div></div><div class="table-categorized-shell-footer"><button type="button" class="is-primary" data-table-categorized-action="build-graph">Build Graph</button><div class="table-categorized-shell-status">Status: Structure recipe ready. Guided field actions update the selected tree node.</div></div>`; }
function selectedPathFor(view) { return String(view.selectedLevelPath || '0').split(',').filter((x) => x !== '').map(Number); }
function levelAtPath(levels = [], path = []) { let current = levels[path[0]]; for (let i = 1; current && i < path.length; i += 1) current = current.children?.[path[i]]; return current || null; }
function renderFieldChoiceList(catalog, selectedPath = []) { if (!catalog.fields.length) return '<p>Read and confirm columns to populate resolver choices.</p>'; const p = selectedPath.join(','); return `<div data-field-catalog-resolver-options="FieldCatalog.v1" data-selected-level-path="${esc(p)}">${catalog.fields.map((f) => renderGuidedFieldChip(f, p)).join('')}</div>`; }
function renderGuidedFieldChip(field, path) { const data = `data-path="${esc(path)}" data-field-id="${esc(field.fieldId)}" data-field-header="${esc(field.header)}" data-field-label="${esc(field.label)}"`; return `<div class="table-categorized-field-action-chip" title="${esc(field.fieldId)}"><strong>${esc(field.label)}</strong><small>${esc(field.header)} ${esc(field.type)}/${esc(field.role)}</small><span><button type="button" data-table-categorized-action="assign-field-key" ${data}>Key</button><button type="button" data-table-categorized-action="assign-field-display" ${data}>Display</button><button type="button" data-table-categorized-action="add-field-resolver" ${data}>XML Field</button><button type="button" data-table-categorized-action="create-child-from-field" ${data}>Child Level</button></span></div>`; }
function renderRecipeTree(levels = [], selectedPath = [], parentPath = []) { return levels.map((level, index) => renderTreeNode(level, [...parentPath, index], selectedPath)).join(''); }
function renderTreeNode(level, path, selectedPath) { const p = path.join(','), root = path.length === 1 && path[0] === 0, active = p === selectedPath.join(','); return `<div class="table-categorized-tree-node ${active ? 'is-selected' : ''}" data-level-path="${p}"><button type="button" data-table-categorized-action="select-level" data-path="${p}">${esc(level.displayName || level.levelId)}</button><small>${esc(nodeSummary(level))}</small><button type="button" data-table-categorized-action="add-child-level" data-path="${p}">+ Child</button><button type="button" data-table-categorized-action="remove-level" data-path="${p}" ${root ? 'disabled aria-disabled="true"' : ''}>Remove</button>${level.children?.length ? `<div class="table-categorized-tree-children">${renderRecipeTree(level.children, selectedPath, path)}</div>` : ''}</div>`; }
function nodeSummary(level = {}) { const xml = level.xmlTag || (level.documentRoot ? 'documentRoot' : 'no XML tag'), mode = level.creationMode || 'mode', key = previewColumn(level.keyResolver) || level.key || '(none)', display = displayColumn(level) || '(default)', count = Object.keys(level.fieldResolvers || {}).length; return `${level.levelType || 'level'} / ${mode} / XML: ${xml} / Key: ${key} / Display: ${display} / Fields: ${count}`; }
function renderSelectedNodePanel(level, path, catalog) { if (!level) return '<div class="table-categorized-shell-side-card"><h4>Selected Node</h4><p>No level selected.</p></div>'; const p = path.join(','), current = levelResolverState(level); return `<div class="table-categorized-shell-side-card" data-table-categorized-selected-node-panel data-level-path="${p}"><h4>Selected Node Properties</h4><p data-table-categorized-node-summary>${esc(nodeSummary(level))}</p><label>Level ID<input data-level-field="levelId" value="${esc(level.levelId || '')}"></label><label>Display Name<input data-level-field="displayName" value="${esc(level.displayName || '')}"></label><label>XML Tag<input data-level-field="xmlTag" value="${esc(level.xmlTag || '')}"></label><label>Level Type<select data-level-field="levelType">${optionList(LEVEL_TYPE_OPTIONS, level.levelType)}</select></label><label>Creation Mode<select data-level-field="creationMode">${optionList(CREATION_MODE_OPTIONS, level.creationMode)}</select></label><label>Key Resolver Field<select data-level-field="keyColumn"><option value="">(None)</option><option value="__concat__" ${current.isConcat ? 'selected' : ''}>Concat Columns...</option>${fieldOptions(catalog, current.keyCol)}</select></label><label>Display Resolver Field<select data-level-display-column>${fieldOptions(catalog, displayColumn(level))}</select></label>${(!current.isConcat && current.keyCol) ? `<label><input type="checkbox" data-level-split-dot="true" ${current.isTakeToken ? 'checked' : ''}>Use text before '.'</label>` : ''}${current.isConcat ? renderConcatOptions((catalog.fields || []).map((f) => f.header), current.concatCols) : ''}<h4>Field Resolvers</h4>${renderFieldResolverList(level.fieldResolvers || {}, catalog)}</div>`; }
function renderStructureLivePreview(source = {}, level = {}, path = [], catalog = {}) { const rows = (source.rows || []).slice(0, 8), keyCol = previewColumn(level?.keyResolver) || (catalog.fields || [])[0]?.header || '', displayCol = displayColumn(level) || keyCol; if (!rows.length) return '<div class="table-categorized-shell-side-card table-categorized-live-preview" data-table-categorized-structure-live-preview><h4>Live Data Preview</h4><p>No parsed rows available yet.</p></div>'; return `<div class="table-categorized-shell-side-card table-categorized-live-preview" data-table-categorized-structure-live-preview><h4>Live Data Preview</h4><p>Selected path ${esc(path.join('.') || '0')} previews ${esc(level?.creationMode || 'node')} using live parsed table rows.</p><table><thead><tr><th>Row</th><th>Key: ${esc(keyCol || '(none)')}</th><th>Display: ${esc(displayCol || '(none)')}</th></tr></thead><tbody>${rows.map((row, index) => `<tr><td>${esc(row.rowId || index + 1)}</td><td>${esc(rowValue(row, keyCol))}</td><td>${esc(rowValue(row, displayCol))}</td></tr>`).join('')}</tbody></table></div>`; }
function previewColumn(resolver = {}) { if (resolver.column) return resolver.column; if (resolver.input?.column) return resolver.input.column; if (resolver.parts?.length) return resolver.parts.find((part) => part?.column)?.column || ''; return ''; }
function rowValue(row = {}, column = '') { return column ? (row.rawByHeader?.[column] ?? row.rawByColumnId?.[column] ?? '') : ''; }
function optionList(options, selected) { return options.map((value) => `<option value="${esc(value)}" ${value === selected ? 'selected' : ''}>${esc(value)}</option>`).join(''); }
function fieldOptions(catalog, selected = '') { return (catalog.fields || []).map((field) => `<option value="${esc(field.header)}" ${field.header === selected || field.columnId === selected ? 'selected' : ''}>${esc(field.label)} (${esc(field.type)})</option>`).join(''); }
function fieldIdOptions(catalog, selected = '') { return (catalog.fields || []).map((field) => `<option value="${esc(field.fieldId)}" ${field.fieldId === selected ? 'selected' : ''}>${esc(field.label)} (${esc(field.type)}/${esc(field.role)})</option>`).join(''); }
function displayColumn(level) { const r = level?.displayNameResolver || {}; if (r.column) return r.column; if (r.input?.column) return r.input.column; return ''; }
function renderFieldResolverList(resolvers, catalog) { const names = Object.keys(resolvers || {}); const rows = names.length ? names.map((name) => `<li>${esc(name)} → ${esc(resolvers[name]?.column || resolvers[name]?.op || 'resolver')}</li>`).join('') : '<li>No field resolvers mapped on this level.</li>'; return `<ul>${rows}</ul><small>Available fields: ${(catalog.fields || []).map((f) => esc(f.label)).join(', ') || 'none'}</small>`; }
function renderSuggestedStructures(view) { const headers = activeFor(view)?.headers || [], suggestions = generateSuggestedProfiles(headers); if (!suggestions.length) return '<p>Load a table with columns to see suggestions.</p>'; return suggestions.map((p, i) => `<div><strong>${esc(p.displayName)}</strong><button type="button" data-table-categorized-action="load-suggested-profile" data-suggestion-index="${i}">+</button><pre>${esc(p.levelDefinitions.map(l => levelText(l, 0)).join('\n'))}</pre></div>`).join(''); }
function renderPreviewStep(view) { return `<div class="table-categorized-shell-split"><div class="table-categorized-shell-main"><div class="table-categorized-shell-side-card"><h4>Structure Preview & Summary</h4>${renderStructureSummary(view)}${renderCheckSummary(view)}${renderBuildLedger(view)}${view.exportResult?.xmlText ? `<pre><code>${esc(view.exportResult.xmlText.slice(0, 10000))}</code></pre>` : ''}</div></div><div class="table-categorized-shell-side"><div class="table-categorized-shell-side-card"><h4>Check Details</h4>${renderValidationList(view)}</div>${renderBuildLedgerDiagnostics(view)}</div></div><div class="table-categorized-shell-footer"><button type="button" class="is-primary" data-table-categorized-step="export" data-table-categorized-tab="export" ${view.graph ? '' : 'disabled'}>Check Output</button><div class="table-categorized-shell-status">Status: ${view.validationResults?.length ? 'Checks completed.' : 'Ready to check.'}</div></div>`; }
function renderBuildLedger(view = {}) { if (!view.graph) return '<div data-table-categorized-build-ledger-empty><h4>Build Trace Ledger</h4><p>Build graph first to see resolver and sourceRef evidence.</p></div>'; const ledger = createBuildLedger(view.profile || {}, sourcesFor(view), view.graph); return `<div data-table-categorized-build-ledger="BuildLedger.v1"><h4>Build Trace Ledger</h4><p>${ledger.entries.length} recipe level(s), ${ledger.sourceIds.length} source table(s), ${ledger.diagnostics.length} ledger diagnostic(s).</p><table><thead><tr><th>Path</th><th>Level</th><th>XML</th><th>Key resolver</th><th>Nodes</th><th>SourceRefs</th><th>Merged</th><th>Blank keys</th><th>Sample keys</th></tr></thead><tbody>${ledger.entries.map(renderBuildLedgerRow).join('')}</tbody></table></div>`; }
function renderBuildLedgerRow(entry = {}) { return `<tr data-build-ledger-level-id="${esc(entry.levelId)}" data-build-ledger-path="${esc(entry.path)}"><td>${esc(entry.path)}</td><td>${esc(entry.levelId)}<br><small>${esc(entry.levelType)} / ${esc(entry.creationMode)}</small></td><td>${esc(entry.xmlTag || '(none)')}</td><td>${esc(resolverLabel(entry.keyResolver))}</td><td>${esc(entry.nodeCount)}</td><td>${esc(entry.sourceRefCount)}</td><td>${esc(entry.duplicateMergeCount)}</td><td>${esc(entry.blankKeyCount)}</td><td>${esc((entry.sampleKeys || []).join(', ') || '(none)')}</td></tr>`; }
function renderBuildLedgerDiagnostics(view = {}) { if (!view.graph) return ''; const ledger = createBuildLedger(view.profile || {}, sourcesFor(view), view.graph); if (!ledger.diagnostics.length) return '<div class="table-categorized-shell-side-card" data-table-categorized-build-ledger-diagnostics><h4>Build Ledger Diagnostics</h4><p>No build-ledger diagnostics.</p></div>'; return `<div class="table-categorized-shell-side-card" data-table-categorized-build-ledger-diagnostics><h4>Build Ledger Diagnostics</h4><ul>${ledger.diagnostics.slice(0, 10).map((item) => `<li>${esc(item.severity || 'INFO')}: ${esc(item.message || item.code)}</li>`).join('')}</ul></div>`; }
function resolverLabel(resolver = {}) { if (resolver.column) return `${resolver.op || 'resolver'}:${resolver.column}`; if (resolver.literal) return `literal:${resolver.literal}`; return resolver.op || '(none)'; }
function renderExportStep(view) { const ready = Boolean(view.exportResult?.ok); return `<div class="table-categorized-shell-split"><div class="table-categorized-shell-main"><div class="table-categorized-export-status-banner ${ready ? 'is-ready' : 'is-not-ready'}">${renderExportStatus(view)}</div>${renderPivotDesigner(view)}<div class="table-categorized-shell-footer-inline"><button type="button" class="is-primary is-large" data-table-categorized-download="xml" ${ready ? '' : 'disabled'}>Download XML</button></div></div><div class="table-categorized-shell-side"><div class="table-categorized-shell-side-card"><h4>Advanced Export</h4><button type="button" data-table-categorized-download="graph" ${ready ? '' : 'disabled'}>Download Graph JSON</button><button type="button" data-table-categorized-download="profile">Download Recipe JSON</button><button type="button" data-table-categorized-download="diagnostics" ${ready ? '' : 'disabled'}>Download Diagnostics JSON</button><button type="button" data-table-categorized-download="audit" ${ready ? '' : 'disabled'}>Download Audit JSON</button><hr/><h4>Canvas Handoff</h4>${renderCanvasActionsOnly(view)}</div></div></div>`; }
function renderPivotDesigner(view = {}) { const catalog = buildFieldCatalog([activeFor(view)]), views = (view.profile?.outputViews || []).filter((item) => item.type === 'pivot'), active = views.find((item) => item.viewId === view.activePivotViewId) || views[0], status = pivotDownloadStatus(view, active, catalog); return `<div class="table-categorized-shell-side-card" data-table-categorized-pivot-designer><h4>Pivot Designer <small>Guarded Preview</small></h4><p>Create, preview, and download OutputView.v1 pivot artifacts. XLSX is intentionally excluded.</p><button type="button" data-table-categorized-action="add-pivot-view" ${catalog.fields.length ? '' : 'disabled'}>+ Add Pivot View</button>${views.length ? `<div data-pivot-view-list>${views.map((item) => `<button type="button" data-table-categorized-action="select-pivot-view" data-view-id="${esc(item.viewId)}" ${active?.viewId === item.viewId ? 'aria-pressed="true"' : ''}>${esc(item.displayName || item.viewId)}</button>`).join('')}</div>` : '<p>No pivot views yet.</p>'}${active ? renderPivotControls(active, catalog) : ''}${active ? '<button type="button" data-table-categorized-action="remove-pivot-view">Remove Pivot View</button>' : ''}${renderPivotDownloadControls(status)}${renderPivotPreview(view, active, catalog, status)}</div>`; }
function renderPivotControls(view, catalog) { return `<div data-pivot-view-id="${esc(view.viewId)}"><label>View Name<input data-pivot-field="displayName" value="${esc(view.displayName || '')}"></label><label><input type="checkbox" data-pivot-field="enabled" ${view.enabled === false ? '' : 'checked'}>Enabled</label>${renderPivotZone('rows', 'Row Fields', view.pivotSpec?.rows || [], catalog)}${renderPivotZone('columns', 'Column Fields', view.pivotSpec?.columns || [], catalog)}${renderPivotValueZone(view.pivotSpec?.values || [], catalog)}${renderPivotFilterZone(view.pivotSpec?.filters || [], catalog)}</div>`; }
function renderPivotZone(zone, title, refs, catalog) { return `<section data-pivot-zone="${zone}"><h5>${title}</h5>${refs.map((ref, i) => `<div data-pivot-zone-item="${zone}" data-pivot-index="${i}"><select data-pivot-field="${zone === 'rows' ? 'rowFieldId' : 'columnFieldId'}" data-pivot-zone="${zone}" data-pivot-index="${i}"><option value="">(None)</option>${fieldIdOptions(catalog, ref.fieldId)}</select><button type="button" data-table-categorized-action="remove-pivot-${zone === 'rows' ? 'row' : 'column'}-field" data-pivot-index="${i}">Remove ${zone === 'rows' ? 'Row' : 'Column'}</button></div>`).join('')}<button type="button" data-table-categorized-action="add-pivot-${zone === 'rows' ? 'row' : 'column'}-field">+ Add ${zone === 'rows' ? 'Row' : 'Column'} Field</button></section>`; }
function renderPivotValueZone(values, catalog) { return `<section data-pivot-zone="values"><h5>Value Fields</h5>${values.map((value, i) => `<div data-pivot-zone-item="values" data-pivot-index="${i}"><select data-pivot-field="valueFieldId" data-pivot-index="${i}"><option value="">(None)</option>${fieldIdOptions(catalog, value.fieldId)}</select><select data-pivot-field="aggregate" data-pivot-index="${i}">${PIVOT_AGGREGATES.map((agg) => `<option value="${agg}" ${agg === value.aggregate ? 'selected' : ''}>${agg}</option>`).join('')}</select><button type="button" data-table-categorized-action="remove-pivot-value-field" data-pivot-index="${i}">Remove Value</button></div>`).join('')}<button type="button" data-table-categorized-action="add-pivot-value-field">+ Add Value Field</button></section>`; }
function renderPivotFilterZone(filters, catalog) { return `<section data-pivot-filter-list="true"><h5>Filters</h5>${filters.map((filter, i) => `<div data-pivot-filter-index="${i}" data-pivot-index="${i}"><select data-pivot-filter-field data-pivot-index="${i}"><option value="">(Field)</option>${fieldIdOptions(catalog, filter.fieldId)}</select><select data-pivot-filter-operator data-pivot-index="${i}">${PIVOT_FILTER_OPERATORS.map((op) => `<option value="${op}" ${op === filterOperator(filter) ? 'selected' : ''}>${op}</option>`).join('')}</select><input data-pivot-filter-value data-pivot-index="${i}" value="${esc(filterValue(filter))}"><button type="button" data-table-categorized-action="remove-pivot-filter" data-pivot-index="${i}">Remove Filter</button></div>`).join('')}<button type="button" data-table-categorized-action="add-pivot-filter">+ Add Filter</button></section>`; }
function filterOperator(filter = {}) { if ('notEquals' in filter) return 'notEquals'; if ('contains' in filter) return 'contains'; if ('notContains' in filter) return 'notContains'; if (filter.operator) return filter.operator; if ('equals' in filter || 'value' in filter) return 'equals'; return 'notBlank'; }
function filterValue(filter = {}) { return filter.equals ?? filter.notEquals ?? filter.contains ?? filter.notContains ?? filter.value ?? ''; }
function renderPivotDownloadControls(status) { const disabled = status.ok ? '' : 'disabled aria-disabled="true"'; return `<div data-pivot-download-controls><p><b>Active view status:</b> ${esc(status.message)}</p><button type="button" data-table-categorized-action="download-pivot-json" ${disabled}>Download Pivot JSON</button><button type="button" data-table-categorized-action="download-pivot-csv" ${disabled}>Download Pivot CSV</button><button type="button" data-table-categorized-action="download-pivot-html" ${disabled}>Download Pivot HTML Preview</button></div>`; }
function renderPivotPreview(view, outputView, catalog, status) { if (!outputView) return ''; if (!view.graph) return '<p>Build graph before pivot preview.</p>'; const model = buildPivotViewModel({ graph: view.graph, pivotSpec: outputView.pivotSpec, fieldCatalog: catalog }), html = exportPivotViewModelHtmlPreview(model); return `<div data-pivot-preview-shell><h4>Pivot Preview</h4>${html.text || '<p>Preview not available.</p>'}${renderPivotDrilldown(model)}${renderPivotDiagnostics(status.diagnostics)}</div>`; }
function renderPivotDrilldown(model) { const rows = (model.rows || []).flatMap((row) => (row.cells || []).map((cell) => ({ row: row.label, column: cell.columnKey, refs: cell.sourceRefs || [] }))).filter((item) => item.refs.length).slice(0, 12); return `<div data-pivot-drilldown-preview><h4>SourceRef drilldown</h4>${rows.length ? `<ul>${rows.map((item) => `<li>${esc(item.row)} / ${esc(item.column)}: ${item.refs.length} sourceRefs — ${esc(item.refs.join(', '))}</li>`).join('')}</ul>` : '<p>No sourceRefs in current pivot cells.</p>'}</div>`; }
function pivotDownloadStatus(view, outputView, catalog) { const diagnostics = []; if (!outputView) diagnostics.push(pivotDiag('pivot_view_missing', 'Add or select a pivot view.')); if (!catalog.fields?.length) diagnostics.push(pivotDiag('pivot_field_catalog_missing', 'Read table columns before pivot download.')); if (!view.graph) diagnostics.push(pivotDiag('pivot_graph_missing', 'Build graph before pivot download.')); if (outputView && view.graph && catalog.fields?.length) diagnostics.push(...buildPivotViewModel({ graph: view.graph, pivotSpec: outputView.pivotSpec, fieldCatalog: catalog }).diagnostics); const failed = diagnostics.some((item) => ['BLOCKER', 'ERROR'].includes(item.severity)); return { ok: !failed, diagnostics, message: failed ? `${diagnostics.length} pivot issue(s) need review.` : `Ready: ${outputView?.viewId || 'pivot'}` }; }
function pivotDiag(code, message) { return Object.freeze({ gate: code, severity: 'BLOCKER', status: 'FAIL', code, message }); }
function renderPivotDiagnostics(items = []) { if (!items.length) return '<p>No pivot diagnostics.</p>'; return `<ul data-pivot-diagnostics>${items.slice(0, 8).map((item) => `<li>${esc(item.severity || 'INFO')}: ${esc(item.message || item.code)}</li>`).join('')}</ul>`; }
function renderDelimiterSelect(source = {}) { const mode = source.delimiterMode || 'auto', custom = source.customDelimiter || ''; return `<label>Delimiter<select data-table-categorized-delimiter-mode>${DELIMITER_MODE_OPTIONS.map((item) => `<option value="${esc(item)}" ${item === mode ? 'selected' : ''}>${delimiterLabel(item)}</option>`).join('')}</select></label>${mode === 'custom' ? `<label>Custom Delimiter<input type="text" data-table-categorized-custom-delimiter value="${esc(custom)}"></label>` : ''}`; }
function delimiterLabel(mode) { return { auto: 'Auto-detect', tab: 'Tab', comma: 'Comma', pipe: 'Pipe', semicolon: 'Semicolon', whitespace: 'Whitespace', custom: 'Custom...' }[mode] || mode; }
function renderRawPreview(source = {}) { const rows = (source.rows || []).slice(0, 8); if (!rows.length) return '<p>No rows parsed yet.</p>'; return `<table><thead><tr>${(source.headers || []).map((h) => `<th>${esc(h)}</th>`).join('')}</tr></thead><tbody>${rows.map((row) => `<tr>${(row.rawCells || []).map((cell) => `<td>${esc(cell)}</td>`).join('')}</tr>`).join('')}</tbody></table>`; }
function levelText(level, depth) { const line = `${'  '.repeat(depth)}- ${level.displayName || level.levelId || 'XML level'}`; return [line, ...(level.children || []).map((child) => levelText(child, depth + 1))].join('\n'); }
function renderStructureSummary(view = {}) { if (!view.graph) return '<p>Structure preview not built yet.</p>'; return `<p>Structure preview ready: ${view.graph.nodes?.length || 0} items, ${view.graph.edges?.length || 0} links.</p>`; }
function renderCheckSummary(view = {}) { const items = view.validationResults || []; if (!items.length) return '<p>No checks have run yet.</p>'; const fail = items.filter((item) => ['BLOCKER', 'ERROR'].includes(item?.severity)).length; return `<p>${fail ? `${fail} check issue(s) need review.` : 'Checks completed with no blockers.'}</p>`; }
function renderValidationList(view = {}) { const items = view.validationResults || []; if (!items.length) return '<p>No check details yet.</p>'; return `<ul>${items.slice(0, 12).map((item) => `<li>${esc(item.severity || 'INFO')}: ${esc(item.message || item.code)}</li>`).join('')}</ul>`; }
function renderExportStatus(view = {}) { if (view.exportResult?.ok) return `<p><b>Categorized XML ready.</b></p><p>${esc(view.exportStatus || 'Export files are ready.')}</p>`; return `<p><b>Export not ready.</b></p><p>${esc(view.exportStatus || 'Build the structure first, then check output.')}</p>`; }
function renderCanvasActionsOnly(view = {}) { return `<label class="table-categorized-file">Target Structure JSON<input type="file" data-table-categorized-target-graph-input></label><button type="button" data-table-categorized-action="use-current-graph-source-canvas" ${view.graph ? '' : 'disabled'}>Use Current Structure as Source</button><button type="button" data-table-categorized-action="use-imported-graph-target-canvas">Use Imported Structure as Target</button><button type="button" data-table-categorized-action="send-source" ${view.exportResult?.ok ? '' : 'disabled'}>Send to SourceXML Canvas</button><button type="button" data-table-categorized-action="send-target" ${view.exportResult?.ok ? '' : 'disabled'}>Send to TargetXML Canvas</button><details><summary>Simple guided flow. Extra tools stay behind inline options.</summary><button type="button" data-table-categorized-action="run-graph-compare-canvas">Run Graph Compare</button><button type="button" data-table-categorized-action="build-graph-connectors">Build Graph Connectors</button><button type="button" data-table-categorized-action="download-graph-connectors-json">Download Connectors JSON</button><button type="button" data-table-categorized-action="clear-compare-canvas-preview">Clear Compare Preview</button></details>${renderPendingCanvasHandoff(view.pendingHandoff)}`; }
function renderPendingCanvasHandoff(pending = null) { if (!pending?.summary) return ''; const s = pending.summary; return `<div data-table-categorized-pending-handoff><h4>Confirm canvas handoff</h4><p>Target: ${esc(s.targetCanvas)}. Root: ${esc(s.xmlRoot)}. ${esc(s.byteCount)} bytes across ${esc(s.lineCount)} line(s).</p><p>${esc(s.origin)}. ${esc(s.warning)}</p><button type="button" data-table-categorized-action="confirm-canvas-handoff">Confirm Send</button><button type="button" data-table-categorized-action="cancel-canvas-handoff">Cancel</button></div>`; }
function renderLevelBuilder(levels = [], view = {}, path = []) { return renderRecipeTree(levels, selectedPathFor(view), path); }
function levelResolverState(level = {}) { const isTakeToken = level.keyResolver?.op === 'takeToken', keyCol = isTakeToken ? level.keyResolver.input?.column : (level.keyResolver?.column || ''), isConcat = level.keyResolver?.op === 'concat', concatCols = isConcat ? (level.keyResolver.parts || []).filter(p => p && typeof p === 'object').map(p => p.column) : []; return { isTakeToken, keyCol, isConcat, concatCols }; }
function renderConcatOptions(headers, concatCols) { return `<div>${headers.map(h => `<label><input type="checkbox" data-level-concat-column="${esc(h)}" ${concatCols.includes(h) ? 'checked' : ''}>${esc(h)}</label>`).join('')}</div>`; }
