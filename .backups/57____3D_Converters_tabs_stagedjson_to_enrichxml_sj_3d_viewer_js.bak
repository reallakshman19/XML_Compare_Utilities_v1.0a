/**
 * Functionality: renders a 3D orthographic pipeline routing preview 
 * from the enriched records. Supports rotation, zoom, and node hover.
 * Parameters: explicit. Outputs: DOM panel. No side effects.
 */

export function build3dViewerPanel(records = []) {
  const container = document.createElement('div');
  container.className = 'sj-3d-container';

  // Check if there is 3D data
  const nodes = [];
  records.forEach(rec => {
    const rawPos = rec.attrs?.POS || rec.attrs?.APOS || rec.attrs?.LPOS;
    if (rawPos && typeof rawPos === 'object' && Number.isFinite(rawPos.x) && Number.isFinite(rawPos.y) && Number.isFinite(rawPos.z)) {
      nodes.push({
        id: rec.name || Math.random().toString(),
        name: rec.name || 'UNNAMED',
        type: rec.componentType || 'PIPE',
        branch: rec.branchName || '/UNMAPPED',
        bore: rec.boreMm,
        rating: rec.resolved?.rating || '',
        x: Number(rawPos.x),
        y: Number(rawPos.y),
        z: Number(rawPos.z),
        record: rec
      });
    }
  });

  if (nodes.length === 0) {
    const empty = document.createElement('div');
    empty.className = 'sj-atbl-empty';
    empty.innerHTML = `
      <span class="sj-atbl-empty-icon">🌐</span>
      <span class="sj-atbl-empty-msg">No 3D coordinate data available in the staged JSON.</span>
    `;
    container.appendChild(empty);
    return container;
  }

  // Bounding box calculations
  const xs = nodes.map(n => n.x);
  const ys = nodes.map(n => n.y);
  const zs = nodes.map(n => n.z);
  
  const minX = Math.min(...xs), maxX = Math.max(...xs);
  const minY = Math.min(...ys), maxY = Math.max(...ys);
  const minZ = Math.min(...zs), maxZ = Math.max(...zs);

  const centerX = (minX + maxX) / 2;
  const centerY = (minY + maxY) / 2;
  const centerZ = (minZ + maxZ) / 2;

  // Max dimension for scaling
  const sizeX = maxX - minX;
  const sizeY = maxY - minY;
  const sizeZ = maxZ - minZ;
  const maxDim = Math.max(sizeX, sizeY, sizeZ, 1);

  // Set up Canvas
  const canvas = document.createElement('canvas');
  canvas.className = 'sj-3d-canvas';
  container.appendChild(canvas);

  // Set up Tooltip
  const tooltip = document.createElement('div');
  tooltip.className = 'sj-3d-tooltip';
  container.appendChild(tooltip);

  // Instructions
  const inst = document.createElement('div');
  inst.className = 'sj-3d-instructions';
  inst.textContent = 'Drag to Rotate | Scroll to Zoom';
  container.appendChild(inst);

  // 3D rotation state
  let theta = Math.PI / 4; // rotation around vertical axis (Z)
  let phi = Math.PI / 6;   // rotation around horizontal axis (X)
  let scale = 1.0;
  let offsetX = 0;
  let offsetY = 0;
  let hoveredNode = null;

  // Resize handler
  const resize = () => {
    const rect = container.getBoundingClientRect();
    canvas.width = rect.width || 600;
    canvas.height = rect.height || 400;
    draw();
  };

  // ResizeObserver to handle layout changes
  const observer = new ResizeObserver(() => {
    resize();
  });
  observer.observe(container);

  // Canvas context
  const ctx = canvas.getContext('2d');

  // Projection logic
  const project = (x, y, z) => {
    // Center the points
    const dx = x - centerX;
    const dy = y - centerY;
    const dz = z - centerZ;

    // Rotate around Z axis (theta)
    const x1 = dx * Math.cos(theta) - dy * Math.sin(theta);
    const y1 = dx * Math.sin(theta) + dy * Math.cos(theta);
    const z1 = dz;

    // Rotate around X axis (phi)
    const x2 = x1;
    const y2 = y1 * Math.cos(phi) - z1 * Math.sin(phi);
    const z2 = y1 * Math.sin(phi) + z1 * Math.cos(phi);

    // Apply scale and offsets
    const wScale = (Math.min(canvas.width, canvas.height) * 0.7) / maxDim * scale;
    const screenX = canvas.width / 2 + x2 * wScale + offsetX;
    const screenY = canvas.height / 2 - y2 * wScale + offsetY;

    return { x: screenX, y: screenY, depth: z2 };
  };

  // Drawing loop
  const draw = () => {
    ctx.clearRect(0, 0, canvas.width, canvas.height);

    // Group nodes by branch so we can draw branch lines
    const branches = new Map();
    nodes.forEach(n => {
      // Project node coordinates
      const proj = project(n.x, n.y, n.z);
      n.screenX = proj.x;
      n.screenY = proj.y;
      n.depth = proj.depth;

      if (!branches.has(n.branch)) branches.set(n.branch, []);
      branches.get(n.branch).push(n);
    });

    // Draw branch pipeline segments (lines)
    ctx.save();
    ctx.lineJoin = 'round';
    ctx.lineCap = 'round';
    
    for (const [, bNodes] of branches.entries()) {
      if (bNodes.length < 2) continue;
      
      ctx.beginPath();
      ctx.moveTo(bNodes[0].screenX, bNodes[0].screenY);
      for (let i = 1; i < bNodes.length; i++) {
        ctx.lineTo(bNodes[i].screenX, bNodes[i].screenY);
      }
      ctx.strokeStyle = '#38bdf8'; // solid line cyan
      ctx.lineWidth = 4;
      ctx.stroke();
    }
    ctx.restore();

    // Draw component node circles/markers
    nodes.forEach(n => {
      ctx.beginPath();
      
      let radius = 6;
      let color = '#cbd5e1'; // grey standard
      
      if (n.type === 'VALV') {
        radius = 8;
        color = '#facc15'; // yellow valves
      } else if (n.type === 'ATTA' || n.type === 'SUPPORT') {
        radius = 7;
        color = '#3fb950'; // green supports
      } else if (n.type === 'ELBO' || n.type === 'BEND') {
        radius = 5;
        color = '#58a6ff'; // blue elbows
      }

      const isHovered = (n === hoveredNode);
      if (isHovered) {
        radius += 3;
        ctx.strokeStyle = '#ffffff';
        ctx.lineWidth = 2;
      } else {
        ctx.strokeStyle = '#0f172a';
        ctx.lineWidth = 1;
      }

      ctx.arc(n.screenX, n.screenY, radius, 0, Math.PI * 2);
      ctx.fillStyle = color;
      ctx.fill();
      ctx.stroke();

      if (isHovered) {
        ctx.fillStyle = '#ffffff';
        ctx.font = 'bold 10px monospace';
        ctx.textAlign = 'center';
        ctx.fillText(n.type, n.screenX, n.screenY - radius - 4);
      }
    });
  };

  // Interactions (Mouse/Touch Drag, Wheel)
  let isDragging = false;
  let startX = 0;
  let startY = 0;

  canvas.onmousedown = e => {
    isDragging = true;
    startX = e.clientX;
    startY = e.clientY;
  };

  window.onmouseup = () => {
    isDragging = false;
  };

  canvas.onmousemove = e => {
    const rect = canvas.getBoundingClientRect();
    const mx = e.clientX - rect.left;
    const my = e.clientY - rect.top;

    if (isDragging) {
      const dx = e.clientX - startX;
      const dy = e.clientY - startY;
      theta -= dx * 0.007;
      phi -= dy * 0.007;
      startX = e.clientX;
      startY = e.clientY;
      draw();
    } else {
      let best = null;
      let dist = 12; // hit radius
      nodes.forEach(n => {
        const d = Math.hypot(n.screenX - mx, n.screenY - my);
        if (d < dist) {
          dist = d;
          best = n;
        }
      });

      if (best !== hoveredNode) {
        hoveredNode = best;
        draw();

        if (hoveredNode) {
          tooltip.style.display = 'block';
          tooltip.style.left = (mx + 15) + 'px';
          tooltip.style.top = (my + 15) + 'px';
          tooltip.innerHTML = `
            <strong>NAME:</strong> ${hoveredNode.name}<br/>
            <strong>TYPE:</strong> ${hoveredNode.type}<br/>
            <strong>BORE:</strong> ${hoveredNode.bore}mm<br/>
            <strong>RATING:</strong> ${hoveredNode.rating || 'N/A'}<br/>
            <strong>BRANCH:</strong> ${hoveredNode.branch}<br/>
            <strong>POS:</strong> (${hoveredNode.x.toFixed(0)}, ${hoveredNode.y.toFixed(0)}, ${hoveredNode.z.toFixed(0)})
          `;
        } else {
          tooltip.style.display = 'none';
        }
      } else if (hoveredNode) {
        tooltip.style.left = (mx + 15) + 'px';
        tooltip.style.top = (my + 15) + 'px';
      }
    }
  };

  canvas.onwheel = e => {
    e.preventDefault();
    if (e.deltaY < 0) {
      scale *= 1.1;
    } else {
      scale /= 1.1;
    }
    draw();
  };

  return container;
}
