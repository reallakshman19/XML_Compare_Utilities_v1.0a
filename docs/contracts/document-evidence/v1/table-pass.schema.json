{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.xml-compare-utilities.local/document-evidence/v1/table-pass.schema.json",
  "title": "TablePass.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "tablePassId", "tablePassHash", "tableCandidateId", "passId", "sourceHash", "surfaceId", "surfaceHash", "cells"],
  "properties": {
    "schema": {"const": "TablePass.v1"},
    "tablePassId": {"type": "string", "minLength": 1},
    "tablePassHash": {"type": "string", "minLength": 1},
    "tableCandidateId": {"type": "string", "minLength": 1},
    "passId": {"type": "string", "minLength": 1},
    "sourceHash": {"type": "string", "minLength": 1},
    "surfaceId": {"type": "string", "minLength": 1},
    "surfaceHash": {"type": "string", "minLength": 1},
    "cells": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cellId", "rowIndex", "columnIndex", "geometry", "observationHashes"],
        "properties": {
          "cellId": {"type": "string", "minLength": 1},
          "rowIndex": {"type": "integer", "minimum": 0},
          "columnIndex": {"type": "integer", "minimum": 0},
          "geometry": {"$ref": "geometry.schema.json"},
          "observationHashes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
