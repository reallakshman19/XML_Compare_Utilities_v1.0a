{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://contracts.xml-compare-utilities.local/document-evidence/v1/geometry.schema.json",
  "title":"Geometry.v1",
  "oneOf":[
    {"$ref":"#/$defs/point"},
    {"$ref":"#/$defs/quad"},
    {"$ref":"#/$defs/polygon"},
    {"$ref":"#/$defs/path"}
  ],
  "$defs":{
    "xy":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"number"}},
    "point":{"type":"object","additionalProperties":false,"required":["type","coordinates"],"properties":{"type":{"const":"Point"},"coordinates":{"$ref":"#/$defs/xy"}}},
    "quad":{"type":"object","additionalProperties":false,"required":["type","coordinates"],"properties":{"type":{"const":"Quad"},"coordinates":{"type":"array","minItems":4,"maxItems":4,"items":{"$ref":"#/$defs/xy"}}}},
    "polygon":{"type":"object","additionalProperties":false,"required":["type","coordinates"],"properties":{"type":{"const":"Polygon"},"coordinates":{"type":"array","minItems":3,"items":{"$ref":"#/$defs/xy"}}}},
    "path":{"type":"object","additionalProperties":false,"required":["type","segments"],"properties":{"type":{"const":"Path"},"segments":{"type":"array","items":{"$ref":"#/$defs/segment"}}}},
    "segment":{"oneOf":[
      {"type":"object","additionalProperties":false,"required":["op","to"],"properties":{"op":{"const":"M"},"to":{"$ref":"#/$defs/xy"}}},
      {"type":"object","additionalProperties":false,"required":["op","to"],"properties":{"op":{"const":"L"},"to":{"$ref":"#/$defs/xy"}}},
      {"type":"object","additionalProperties":false,"required":["op","c1","c2","to"],"properties":{"op":{"const":"C"},"c1":{"$ref":"#/$defs/xy"},"c2":{"$ref":"#/$defs/xy"},"to":{"$ref":"#/$defs/xy"}}},
      {"type":"object","additionalProperties":false,"required":["op"],"properties":{"op":{"const":"Z"}}}
    ]}
  }
}
